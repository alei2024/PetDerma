/* pages/diagnosis/result/result.wxss */
/* 基础变量定义 */
:root {
  --bg-gray: #f6f8fa;
  --text-dark: #333333;
  --text-gray: #666666;
  --primary-light: #a5d7e8;
  --primary-blue: #4a90b8;
  --danger-red: #ff6b6b;
  --border-gray: #eeeeee;
}

.container {
  padding: 30rpx;
  background-color: var(--bg-gray);
  height: 100vh;
  box-sizing: border-box;
  overflow-y: scroll;
  -webkit-overflow-scrolling: touch;
  width: 104vw;
}

/* 通用卡片样式 */
.card {
  background-color: #fff;
  border-radius: 24rpx;
  max-width: 690rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  overflow: hidden;
}

/* 图片展示区域 */
.image-section {
  width: 100%;
  margin-bottom: 30rpx;
  padding: 20rpx; /* 调整内边距 */
  box-sizing: border-box;
}

.result-image-grid {
  display: flex;
  flex-wrap: wrap; /* 图片自动换行 */
  gap: 16rpx;
  width: 100%;
}

.result-image-item {
  width: calc(33.33% - 12rpx); /* 3列布局 */
  height: 200rpx;
  border-radius: 16rpx;
  object-fit: cover;
}

/* 图片标记提示 */
.image-mark-tip {
  margin-top: 16rpx;
  padding: 8rpx 16rpx;
  background-color: rgba(255, 107, 107, 0.1);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--danger-red);
  display: inline-block;
}

/* 诊断结果区域 */
.result-section {
  margin-bottom: 30rpx;
  padding: 30rpx;
  box-sizing: border-box;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text-dark);
}

.pet-type {
  font-size: 28rpx;
  color: var(--primary-blue);
  background-color: rgba(165, 215, 232, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.disease-info {
  margin-bottom: 30rpx;
}

.disease-name {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-dark);
  margin-bottom: 24rpx;
  line-height: 1.3;
}

/* 统一标题宽度，确保左侧对齐 */
.confidence-label,
.severity-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 16rpx;
  width: 140rpx; /* 固定相同宽度 */
  display: inline-block; /* 确保宽度生效 */
  text-align: left; /* 文字左对齐 */
}

/* 可信度样式 */
.confidence {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 5rpx 0; /* 增加上下内边距，保持垂直对齐 */
}

.confidence-bar-container {
  flex: 1;
  display: flex;
  align-items: center;
}

.confidence-bar-bg {
  flex: 1;
  height: 16rpx;
  background-color: #eee;
  border-radius: 8rpx;
  overflow: hidden;
  margin-right: 16rpx;
}

.confidence-bar {
  height: 100%;
  background-color: #a5d7e8;
  border-radius: 8rpx;
}

.confidence-value {
  font-size: 28rpx;
  color: ##a5d7e8;
  font-weight: bold;
  min-width: 80rpx; /* 固定宽度，防止数字跳动 */
  text-align: right;
}

/* 严重程度样式 */
.severity {
  display: flex;
  align-items: center;
  padding: 5rpx 0; /* 与可信度保持相同上下内边距 */
}

.severity-indicators {
  display: flex;
  gap: 10rpx;
  margin-right: 16rpx;
  align-items: center;
}

.severity-indicator {
  width: 30rpx;
  height: 16rpx;
  background-color: #ddd; /* 灰色默认状态 */
  border-radius: 8rpx;
}

.severity-indicator.active {
  background-color: #a5d7e8; /* 蓝色激活状态 */
}

.severity-text {
  font-size: 28rpx;
  font-weight: 500;
  min-width: 100rpx; /* 固定宽度，防止文字跳动 */
}

/* 疾病描述样式 */
.disease-description {
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid var(--border-gray);
}

.description-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-dark);
  margin-bottom: 16rpx;
  display: block;
}

.description-content {
  font-size: 28rpx;
  color: var(--text-gray);
  line-height: 1.6;
  white-space: pre-line; /* 支持换行显示 */
}

/* 诊疗建议区域 */
.advice-section {
  margin-bottom: 30rpx;
  padding: 30rpx;
  box-sizing: border-box;
}

.advice-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text-dark);
  margin-bottom: 24rpx;
  display: block;
}

.advice-tabs {
  display: flex;
  border-bottom: 2rpx solid var(--border-gray);
  margin-bottom: 24rpx;
}

.advice-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--text-gray);
  position: relative;
  transition: color 0.3s ease;
}

.advice-tab.active {
  color: var(--primary-blue);
  font-weight: bold;
}

.advice-tab.active::after {
  content: "";
  position: absolute;
  bottom: -2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: var(--primary-blue);
  border-radius: 2rpx;
}

.advice-content {
  padding: 10rpx 0;
}

.advice-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.advice-item-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--primary-blue);
  margin-top: 14rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.advice-item-text {
  font-size: 28rpx;
  color: var(--text-gray);
  line-height: 1.6;
  flex: 1;
  white-space: pre-line;
}

/* 操作按钮区域 */
.actions-section {
  display: flex;
  gap: 12rpx;
  margin-bottom: 60rpx; /* 增加底部距离 */
  margin-left: 110rpx;
}

.actions-section .btn {
  flex: 1;
  max-width: 160rpx; /* 限制最大宽度 */
  height: 48rpx; /* 减小按钮高度到原来的一半 */
  display: flex;
  padding-left: 28rpx;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx; /* 与知识科普页面保持一致 */
  font-size: 26rpx; /* 减小字体大小 */
  font-weight: 500;
  transition: all 0.3s ease;
  border: 1rpx solid #e0e0e0;
  background-color: white;
  gap: 0rpx; /* 图标和文字间距 */
  text-align: center; /* 确保文字居中 */
}

.actions-section .btn:active {
  background-color: #f0f0f0;
  transform: scale(0.98); /* 与知识科普页面保持一致的按压效果 */
}

.btn-icon {
  width: 24rpx; /* 减小图标大小 */
  height: 24rpx;
  vertical-align: middle;
  margin-right: 8rpx;
}

.btn-outline {
  color: var(--primary-blue);
}

.btn-primary {
  border-color: var(--primary-light);
  color: var(--primary-blue);
}

.btn-primary:active {
  background-color: rgba(165, 215, 232, 0.1);
}
