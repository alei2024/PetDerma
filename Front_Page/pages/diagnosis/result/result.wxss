/* pages/diagnosis/result/result.wxss */
page {
  --accent-deep: #2c5f7c;
  --accent-mid: #4a90b8;
  --accent-soft: #a5d7e8;
  --accent-pink: #ffb3c1;
  --accent-mint: #a8e6cf;
  --accent-sun: #ffe5a8;
  --warn: #ff6b6b;
  --bg-page: #f4f7fa;
  --text-dark: #1f2d3a;
  --text-gray: #6b7886;
  --text-light: #9aa6b2;
  background: linear-gradient(180deg, #d4ebf4 0%, #f4f7fa 28%, #f4f7fa 100%);
}

.container {
  padding: 24rpx 28rpx 220rpx;
  box-sizing: border-box;
  width: 100%;
  height: 100vh;
  -webkit-overflow-scrolling: touch;
}

/* ===== Hero 诊断卡 ===== */
.diagnosis-hero {
  position: relative;
  width: 100%;
  border-radius: 32rpx;
  padding: 32rpx 32rpx 28rpx;
  margin-bottom: 28rpx;
  color: #ffffff;
  overflow: hidden;
  box-sizing: border-box;
  box-shadow: 0 12rpx 36rpx rgba(44, 95, 124, 0.2);
}
.diagnosis-hero.sev-mild {
  background:
    radial-gradient(140% 100% at 100% 0%, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0) 60%),
    linear-gradient(135deg, #6dd5ed 0%, #2980b9 100%);
}
.diagnosis-hero.sev-moderate {
  background:
    radial-gradient(140% 100% at 100% 0%, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0) 60%),
    linear-gradient(135deg, #f6a96b 0%, #ee6c4d 100%);
}
.diagnosis-hero.sev-severe {
  background:
    radial-gradient(140% 100% at 100% 0%, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0) 60%),
    linear-gradient(135deg, #ff7e7e 0%, #c0392b 100%);
}

.hero-decor {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.hero-decor.d1 {
  width: 240rpx;
  height: 240rpx;
  top: -100rpx;
  right: -80rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0) 70%);
}
.hero-decor.d2 {
  width: 160rpx;
  height: 160rpx;
  bottom: -50rpx;
  left: 30rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0) 70%);
}

.pet-pill {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.25);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  padding: 6rpx 18rpx 6rpx 12rpx;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  z-index: 2;
}
.pet-pill-text {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 600;
}
.pet-pill-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 0 6rpx rgba(255, 255, 255, 0.8);
}

.disease-label {
  position: relative;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  opacity: 0.85;
  margin-bottom: 8rpx;
  z-index: 2;
  display: block;
}
.disease-name {
  position: relative;
  font-size: 50rpx;
  font-weight: 800;
  line-height: 1.25;
  margin-bottom: 28rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.18);
  z-index: 2;
  display: block;
}

.hero-meters {
  position: relative;
  display: flex;
  align-items: center;
  gap: 32rpx;
  z-index: 2;
}

/* 圆环可信度 */
.confidence-ring {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 14rpx;
  box-sizing: border-box;
}
.ring-inner {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 4rpx 12rpx rgba(44, 95, 124, 0.1);
}
.ring-row {
  display: flex;
  align-items: baseline;
}
.ring-value {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--accent-deep);
  line-height: 1;
}
.ring-unit {
  font-size: 24rpx;
  color: var(--accent-mid);
  font-weight: 600;
  margin-left: 2rpx;
}
.ring-label {
  font-size: 22rpx;
  color: var(--text-gray);
  margin-top: 4rpx;
}

/* 严重度 */
.severity-gauge {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.gauge-label {
  font-size: 24rpx;
  letter-spacing: 2rpx;
  opacity: 0.88;
}
.gauge-bar {
  width: 100%;
  height: 18rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}
.gauge-fill {
  height: 100%;
  background: linear-gradient(90deg, #ffe5a8 0%, #ff7e7e 60%, #ffffff 100%);
  border-radius: 12rpx;
  transition: width 0.5s ease;
  box-shadow: 0 0 12rpx rgba(255, 255, 255, 0.5);
}
.gauge-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  margin-top: 2rpx;
}

/* ===== 通用卡片 ===== */
.card {
  width: 100%;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(74, 144, 184, 0.06);
  box-sizing: border-box;
}
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--accent-deep);
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.card-title::before {
  content: "";
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, var(--accent-soft), var(--accent-mid));
  border-radius: 4rpx;
}
.card-sub {
  font-size: 22rpx;
  color: var(--text-light);
}
.card-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(165, 215, 232, 0.25);
  color: var(--accent-mid);
}
.card-tag.warn {
  background: rgba(255, 107, 107, 0.12);
  color: var(--warn);
}

/* ===== 图片网格 ===== */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.image-item {
  width: calc(33.33% - 10rpx);
  height: 200rpx;
  border-radius: 18rpx;
  object-fit: cover;
  background: #eef3f7;
}

/* ===== 描述 ===== */
.desc-text {
  font-size: 28rpx;
  color: var(--text-gray);
  line-height: 1.7;
  white-space: pre-line;
}

/* ===== 概率排行 ===== */
.prob-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.prob-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 18rpx;
  background: linear-gradient(135deg, #f7fafc 0%, #ffffff 100%);
  border-radius: 18rpx;
  border: 2rpx solid #eef3f7;
}
.rank-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
  color: #ffffff;
  flex-shrink: 0;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.08);
}
.prob-item.rank-0 .rank-badge {
  background: linear-gradient(135deg, #ffd76a 0%, #ff9f43 100%);
}
.prob-item.rank-1 .rank-badge {
  background: linear-gradient(135deg, #c5d3df 0%, #8a9bab 100%);
}
.prob-item.rank-2 .rank-badge {
  background: linear-gradient(135deg, #d8a98c 0%, #a87554 100%);
}
.prob-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.prob-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.prob-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-dark);
}
.prob-pct {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--accent-mid);
}
.prob-bar {
  width: 100%;
  height: 12rpx;
  background: #eef3f7;
  border-radius: 8rpx;
  overflow: hidden;
}
.prob-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent-soft), var(--accent-mid));
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

/* ===== 诊疗建议 ===== */
.tab-bar {
  display: flex;
  background: #f4f7fa;
  border-radius: 20rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
  gap: 4rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--text-gray);
  border-radius: 16rpx;
  font-weight: 600;
  transition: all 0.25s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.tab.active {
  background: #ffffff;
  color: var(--accent-deep);
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 184, 0.15);
}
.tab.active.tab-home {
  color: #1d6fa5;
}
.tab.active.tab-medical {
  color: #c0392b;
}
.tab.active.tab-prevent {
  color: #2d8a5f;
}

.advice-content {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.advice-step {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 18rpx;
  background: #f7fafc;
  border-radius: 18rpx;
  border-left: 6rpx solid var(--accent-soft);
}
.advice-step.tab-home {
  border-left-color: var(--accent-mid);
  background: linear-gradient(90deg, rgba(165, 215, 232, 0.15), #f7fafc 60%);
}
.advice-step.tab-medical {
  border-left-color: var(--warn);
  background: linear-gradient(90deg, rgba(255, 107, 107, 0.1), #f7fafc 60%);
}
.advice-step.tab-prevent {
  border-left-color: #5dd39e;
  background: linear-gradient(90deg, rgba(168, 230, 207, 0.18), #f7fafc 60%);
}
.step-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--accent-deep);
  flex-shrink: 0;
  margin-top: 4rpx;
  box-shadow: 0 2rpx 6rpx rgba(74, 144, 184, 0.15);
}
.step-text {
  font-size: 28rpx;
  color: var(--text-dark);
  line-height: 1.6;
  flex: 1;
  white-space: pre-line;
}

/* ===== 推荐医院 CTA ===== */
.hospital-cta {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  background: linear-gradient(135deg, rgba(165, 215, 232, 0.4), rgba(168, 230, 207, 0.32));
  border: 2rpx solid rgba(74, 144, 184, 0.28);
  border-radius: 22rpx;
  margin-bottom: 18rpx;
  box-sizing: border-box;
  transition: transform 0.15s ease;
}
.hospital-cta:active {
  transform: scale(0.99);
}
.cta-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 184, 0.18);
}
.cta-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.cta-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent-deep);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.cta-sub {
  font-size: 22rpx;
  color: var(--accent-mid);
}
.cta-arrow {
  font-size: 36rpx;
  color: var(--accent-mid);
  font-weight: 300;
  flex-shrink: 0;
}

/* ===== 警示提示 ===== */
.warning-strip {
  width: 100%;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, rgba(255, 229, 168, 0.5), rgba(255, 200, 112, 0.2));
  border-radius: 20rpx;
  border-left: 6rpx solid #f0a868;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}
.warn-icon {
  font-size: 30rpx;
  flex-shrink: 0;
}
.warn-text {
  flex: 1;
  font-size: 24rpx;
  color: #8a5a2b;
  line-height: 1.5;
}

/* ===== 浮动操作栏 ===== */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 18rpx;
  background: linear-gradient(to top, rgba(244, 247, 250, 1) 0%, rgba(244, 247, 250, 0.92) 60%, rgba(244, 247, 250, 0) 100%);
  box-sizing: border-box;
}
.action-bar .btn {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  gap: 10rpx;
  transition: transform 0.15s ease;
  box-sizing: border-box;
}
.action-bar .btn:active {
  transform: scale(0.97);
}
.btn-icon {
  width: 36rpx;
  height: 36rpx;
}
.btn-secondary {
  background: #ffffff;
  color: var(--accent-mid);
  border: 2rpx solid rgba(74, 144, 184, 0.3);
  box-shadow: 0 6rpx 18rpx rgba(74, 144, 184, 0.1);
}
.btn-primary {
  background: linear-gradient(135deg, #4a90b8 0%, #2c5f7c 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(44, 95, 124, 0.35);
}
.btn-track {
  background: linear-gradient(135deg, #ffe5a8 0%, #f0a868 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(240, 168, 104, 0.35);
}
.btn-emoji {
  font-size: 32rpx;
  margin-right: 4rpx;
}
.btn-disabled {
  opacity: 0.55;
  pointer-events: none;
}
