<!--pages/diagnosis/diagnosis.wxml-->
<!-- 
  诊断页面模板文件
  注意：本页面的宠物数据和样式完全独立于首页
  - 宠物数据使用独立的 petList（ID前缀为 diagnosis_）
  - 样式使用独立的 .diagnosis- 前缀类名
  - 避免与首页产生任何数据或样式冲突
-->
<navigation-bar title="智能诊断" back="{{false}}" color="white" background="#A5D7E8"></navigation-bar>
<scroll-view class="container" scroll-y>
  <!-- 宠物头像选择区 -->
  <view class="pet-select-section">
    <view class="diagnosis-pet-avatars">
      <block wx:for="{{petList}}" wx:key="id" wx:for-index="index" wx:for-item="item">
        <view class="diagnosis-pet-avatar {{selectedPetId === item.id ? 'active' : ''}}" bindtap="selectPet" data-id="{{item.id}}">
          <image class="diagnosis-avatar-img" src="{{item.avatar}}" mode="aspectFill"></image>
          <text class="diagnosis-avatar-name">{{item.name}}</text>
        </view>
      </block>
    </view>
  </view>
  
  <!-- 图像上传区 -->
  <view class="upload-section card">
    <view class="upload-title">
      <view class="title-row">
        <text class="title">上传宠物皮肤照片</text>
        <view class="guide-btn" bindtap="showGuide">拍摄指南</view>
      </view>
      <text class="subtitle">请尽可能清晰地拍摄患处区域</text>
    </view>
    
    <view class="upload-area">
      <block wx:if="{{imageList.length === 0}}">
        <view class="upload-placeholder" bindtap="chooseImage">
          <image class="upload-icon" src="/images/camera_icon.png" mode="aspectFit"></image>
          <text class="upload-text">点击上传照片</text>
          <text class="upload-tip">支持从相册选择或直接拍照</text>
        </view>
      </block>
      <view class="image-grid">
        <block wx:for="{{imageList}}" wx:key="index">
          <view class="image-item">
            <image class="uploaded-image" src="{{item}}" mode="aspectFill"></image>
            <view class="delete-btn" bindtap="deleteImage" data-index="{{index}}">×</view>
          </view>
        </block>
        <view wx:if="{{imageList.length > 0 && imageList.length < 9}}" class="add-image-btn" bindtap="chooseImage">
          <text>+</text>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 症状描述输入区 -->
  <view class="description-section card">
    <view class="desc-title">描述宠物病症</view>
    <textarea class="desc-input" placeholder="请详细描述宠物的症状表现，如：脱毛范围、红肿程度、是否瘙痒等..." 
              value="{{symptomDescription}}" bindinput="onDescInput" maxlength="500" auto-height></textarea>
    <view class="char-count">{{symptomDescription.length}}/500</view>
  </view>
  
  <!-- 智能诊断按钮 -->
  <view class="analysis-section">
    <view class="btn btn-primary analysis-btn" bindtap="startAnalysis">智能诊断</view>
  </view>
</scroll-view>


<!-- 拍摄指南弹窗 -->
<view wx:if="{{showGuideModal}}" class="modal-mask" bindtap="hideGuide"></view>
<view wx:if="{{showGuideModal}}" class="guide-modal">
  <view class="modal-header">
    <text class="modal-title" style="margin-top: 10rpx; display: block;">拍摄指南</text>
    <view class="modal-close" bindtap="hideGuide">×</view>
  </view>
  <scroll-view class="modal-body" scroll-y>
    <view class="guide-tips">
      <view class="guide-tip">
        <image class="tip-icon" src="/images/light_icon.png" mode="aspectFit"></image>
        <text class="tip-text">保持光线充足，避免阴影</text>
      </view>
      <view class="guide-tip">
        <image class="tip-icon" src="/images/focus_icon.png" mode="aspectFit"></image>
        <text class="tip-text">确保患处在照片中央且清晰</text>
      </view>
      <view class="guide-tip">
        <image class="tip-icon" src="/images/multi_icon.png" mode="aspectFit"></image>
        <text class="tip-text">可从多个角度拍摄以提高准确性</text>
      </view>
    </view>
    <view class="example-section guide-tip-divider">
      <view class="example-title">示例图片</view>
      <image class="example-image" src="/images/示例.png" mode="aspectFit"></image>
    </view>
  </scroll-view>
</view>

<!-- 加载中弹窗 -->
<view class="loading-modal" wx:if="{{isLoading}}">
  <view class="loading-content">
    <view class="loading-icon"></view>
    <text class="loading-text">正在分析...</text>
  </view>
</view> 