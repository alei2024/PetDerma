/* pages/diagnosis/chat/chat.wxss */
.container {
  display: flex;
  flex-direction: column;
  height: calc(
    100vh - 270rpx
  ); /* 调整为导航栏(100rpx)+快捷问题(80rpx)+输入区域(110rpx)总高度 */
  background-color: #f5f5f5;
  padding: 0;
  margin-top: -20rpx;
}

/* 聊天消息区域 */
.chat-messages {
  flex: 1;
  padding: 20rpx 30rpx;
  overflow-y: auto;
  margin-bottom: -20rpx; /* 增大底部边距增强防遮挡效果 */
}

.message-date {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-light);
  margin: 20rpx 0;
}

.message {
  display: flex;
  margin-bottom: 30rpx;
  position: relative;
}

.message.system {
  flex-direction: row;
}

.message.user {
  flex-direction: row-reverse;
}

.system-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  margin-left: 10rpx;
  margin-right: -15rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  margin-left: -15rpx;
  margin-right: 15rpx;
}

.system-avatar image,
.user-avatar image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}


.message-content {
  max-width: 70%;
  padding: 20rpx;
  border-radius: 20rpx;
  margin: 0 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

.message.system .message-content {
  background-color: white;
  color: var(--text-dark);
  border-top-left-radius: 4rpx;
}

.message.user .message-content {
  background-color: var(--primary-blue);
  color: white;
  border-top-right-radius: 4rpx;
}

/* 正在输入提示 */
.typing-indicator {
  display: flex;
  margin-bottom: 30rpx;
}

.typing-dots {
  display: flex;
  align-items: center;
  background-color: white;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-left: 20rpx;
  border-top-left-radius: 4rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #cccccc;
  margin: 0 6rpx;
  animation: bounce 1.4s infinite ease-in-out;
}

.dot:nth-child(1) {
  animation-delay: -0.32s;
}

.dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes bounce {
  0%,
  80%,
  100% {
    transform: scale(0);
  }
  40% {
    transform: scale(1);
  }
}

/* 快捷问题 */
.quick-questions {
  padding: 20rpx 30rpx;
  white-space: nowrap;
  background-color: white;
}

.question-tags {
  display: inline-flex;
  gap: 10rpx;
  padding-left: 20rpx;
  padding-right: 20rpx;
}

.question-tag {
  padding: 12rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: var(--text-gray);
  display: inline-block;
}

/* 输入区域 */
.input-area {
  padding: 20rpx 30rpx;
  padding-bottom: 50rpx;
  background-color: white;
  border-top: 2rpx solid #eeeeee;
  width: 95%;
  margin-bottom: -120rpx;
}

.input-box {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  padding: 10rpx 10rpx;
}

.message-input {
  flex: 1;
  height: 70rpx;
  font-size: 28rpx;
  padding: 0 20rpx;
}

.input-actions {
  display: flex;
  align-items: center;
}



.send-btn {
  width: 120rpx;
  height: 60rpx;
  background-color: #cccccc;
  color: white;
  border-radius: 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  margin-left: 10rpx;
  transition: all 0.3s ease;
}

.send-btn.active {
  background-color: var(--primary-blue);
}
