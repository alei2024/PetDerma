<!-- 网络测试页面 -->
<view class="container">
  <view class="header">
    <text class="title">网络连接测试</text>
    <text class="subtitle">诊断WebSocket连接问题</text>
  </view>

  <view class="config-section">
    <view class="config-item">
      <text class="label">服务器地址:</text>
      <input class="input" value="{{baseUrl}}" bindinput="onBaseUrlInput" placeholder="请输入服务器地址" />
    </view>
    <view class="config-item">
      <text class="label">Token:</text>
      <input class="input" value="{{token}}" bindinput="onTokenInput" placeholder="请输入Token" />
    </view>
  </view>

  <view class="button-section">
    <button class="test-btn" bindtap="startNetworkTest" disabled="{{isTesting}}">
      {{isTesting ? '测试中...' : '开始测试'}}
    </button>
    <button class="clear-btn" bindtap="clearResults" disabled="{{isTesting}}">
      清空结果
    </button>
  </view>

  <view class="results-section" wx:if="{{testResults.length > 0}}">
    <view class="results-header">
      <text class="results-title">测试结果</text>
      <button class="copy-btn" bindtap="copyResults" size="mini">复制</button>
    </view>
    
    <view class="results-list">
      <view class="result-item" wx:for="{{testResults}}" wx:key="index">
        <view class="result-header">
          <text class="result-name">{{item.name}}</text>
          <text class="result-status status-{{item.status}}">
            {{item.status === 'success' ? '✓' : item.status === 'error' ? '✗' : '⚠'}}
          </text>
        </view>
        <text class="result-message">{{item.message}}</text>
      </view>
    </view>
  </view>

  <view class="tips-section">
    <text class="tips-title">常见问题解决:</text>
    <view class="tips-list">
      <text class="tip-item">• 确保后端服务器已启动 (npm start)</text>
      <text class="tip-item">• 检查微信开发者工具网络设置</text>
      <text class="tip-item">• 确认勾选"不校验合法域名"</text>
      <text class="tip-item">• 检查防火墙和网络代理设置</text>
    </view>
  </view>
</view>

