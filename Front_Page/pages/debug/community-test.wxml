<!--pages/debug/community-test.wxml-->
<navigation-bar title="社区功能测试" back="{{true}}" color="white" background="#007aff"></navigation-bar>

<view class="container">
  <view class="header">
    <text class="title">🧪 社区功能测试</text>
    <button class="retry-btn" bindtap="onRetryTap" disabled="{{isLoading}}">
      {{isLoading ? '测试中...' : '运行所有测试'}}
    </button>
  </view>

  <!-- 单独测试按钮 -->
  <view class="test-buttons">
    <text class="section-title">单项测试</text>
    <view class="button-grid">
      <button class="test-single-btn" bindtap="singleTestGetPosts" disabled="{{isLoading}}">
        📋 获取帖子列表
      </button>
      <button class="test-single-btn" bindtap="singleTestCreatePost" disabled="{{isLoading}}">
        ✏️ 创建帖子
      </button>
      <button class="test-single-btn" bindtap="singleTestLikePost" disabled="{{isLoading}}">
        👍 点赞功能
      </button>
      <button class="test-single-btn" bindtap="singleTestFavoritePost" disabled="{{isLoading}}">
        ⭐ 收藏功能
      </button>
      <button class="test-single-btn" bindtap="singleTestCommentPost" disabled="{{isLoading}}">
        💬 评论功能
      </button>
    </view>
  </view>

  <!-- 测试结果 -->
  <view class="test-results">
    <text class="section-title">测试结果</text>
    <view wx:if="{{testResults.length === 0}}" class="empty-state">
      <text>{{isLoading ? '正在运行测试...' : '暂无测试结果'}}</text>
    </view>
    <view wx:for="{{testResults}}" wx:key="index" class="test-item {{item.success ? 'success' : 'error'}}">
      <view class="test-header">
        <text class="test-name">{{item.success ? '✅' : '❌'}} {{item.name}}</text>
        <text class="test-time">{{item.time}}</text>
      </view>
      <text class="test-message">{{item.message}}</text>
    </view>
  </view>

  <!-- 帖子列表 -->
  <view class="posts-section" wx:if="{{posts.length > 0}}">
    <text class="section-title">帖子列表 ({{posts.length}})</text>
    <view wx:for="{{posts}}" wx:key="_id" class="post-item" bindtap="onPostTap" data-id="{{item._id}}">
      <view class="post-header">
        <text class="post-title">{{item.title}}</text>
        <text class="post-time">{{item.createdAt}}</text>
      </view>
      <text class="post-content">{{item.content}}</text>
      <view class="post-stats">
        <text class="stat">👍 {{item.likeCount || 0}}</text>
        <text class="stat">💬 {{item.commentCount || 0}}</text>
        <text class="stat">⭐ {{item.favoriteCount || 0}}</text>
      </view>
    </view>
  </view>
</view>
