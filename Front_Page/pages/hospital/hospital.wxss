page {
  --accent-deep: #2c5f7c;
  --accent-mid: #4a90b8;
  --accent-soft: #a5d7e8;
  --accent-warn: #ee6c4d;
  --accent-mint: #a8e6cf;
  --text-dark: #1f2d3a;
  --text-gray: #6b7886;
  --text-light: #9aa6b2;
  background: linear-gradient(180deg, #d4ebf4 0%, #f4f7fa 28%, #f4f7fa 100%);
}

view, scroll-view, image, text, map {
  box-sizing: border-box;
}

navigation-bar {
  display: block;
  margin-top: -43rpx;
}

.page {
  height: calc(100vh + 70rpx);
  width: 100%;
  display: flex;
  flex-direction: column;
  padding: 12rpx 12rpx 0 14rpx;
}

.hero {
  position: relative;
  border-radius: 28rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 14rpx;
  background:
    radial-gradient(120% 120% at 100% 0%, rgba(168, 230, 207, 0.4) 0%, rgba(168, 230, 207, 0) 60%),
    linear-gradient(135deg, #4a90b8 0%, #2c5f7c 100%);
  color: #ffffff;
  overflow: hidden;
  box-shadow: 0 10rpx 28rpx rgba(44, 95, 124, 0.22);
}
.hero-decor {
  position: absolute;
  width: 220rpx;
  height: 220rpx;
  top: -80rpx;
  right: -60rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.32), rgba(255, 255, 255, 0) 70%);
}
.hero-eyebrow {
  position: relative;
  font-size: 22rpx;
  letter-spacing: 5rpx;
  opacity: 0.85;
  display: block;
  margin-bottom: 10rpx;
}
.recommend-banner {
  position: relative;
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.32);
  border-radius: 18rpx;
  padding: 14rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.rec-icon {
  font-size: 26rpx;
  flex-shrink: 0;
}
.rec-text {
  font-size: 24rpx;
  line-height: 1.4;
  color: #fff;
  flex: 1;
}
.rec-num {
  font-size: 28rpx;
  font-weight: 800;
  color: #ffe5a8;
  margin: 0 4rpx;
}

.tab-bar {
  display: flex;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 6rpx;
  margin-bottom: 10rpx;
  box-shadow: 0 4rpx 14rpx rgba(74, 144, 184, 0.06);
  flex-shrink: 0;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: var(--text-gray);
  border-radius: 14rpx;
  font-weight: 600;
}
.tab.active {
  background: linear-gradient(135deg, #4a90b8, #2c5f7c);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(44, 95, 124, 0.25);
}

.tool-row {
  display: flex;
  gap: 10rpx;
  overflow-x: auto;
  padding: 2rpx 0 10rpx;
  white-space: nowrap;
  flex-shrink: 0;
  position: relative;
  z-index: 5;
  background: transparent;
}
.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 54rpx;
  padding: 0 18rpx;
  border-radius: 27rpx;
  background: #ffffff;
  color: var(--text-gray);
  border: 2rpx solid rgba(74, 144, 184, 0.16);
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.pill-active {
  background: rgba(74, 144, 184, 0.12);
  color: var(--accent-deep);
  border-color: rgba(74, 144, 184, 0.45);
}

.map-wrap {
  position: relative;
  flex: 1;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 22rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 184, 0.08);
}
.map {
  width: 100%;
  height: 100%;
}
.map-card-wrap {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  z-index: 12;
}
.map-hospital-card {
  margin-bottom: 0;
  max-height: 30vh;
  overflow-y: auto;
  padding-bottom: 16rpx;
}
.map-btn {
  margin-top: 10rpx;
  height: 78rpx;
  border-radius: 39rpx;
  background: linear-gradient(135deg, #4a90b8, #2c5f7c);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 22rpx rgba(44, 95, 124, 0.3);
}
.map-btn-ghost {
  background: #ffffff;
  color: var(--accent-deep);
  border: 2rpx solid rgba(74, 144, 184, 0.32);
  box-shadow: none;
}

.list-scroll {
  flex: 1;
  min-height: 0;
  margin-right: -34rpx;
  padding-right: 2rpx;
  padding-bottom: calc(230rpx + env(safe-area-inset-bottom));
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  font-size: 24rpx;
  color: var(--text-light);
}

.hospital-card {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 184, 0.07);
}
.hospital-card:active {
  transform: scale(0.99);
}
.hospital-card.card-matched {
  border: 2rpx solid rgba(238, 108, 77, 0.5);
  background: linear-gradient(135deg, #fff8f3 0%, #ffffff 50%);
}
.hospital-card.card-selected {
  border: 2rpx solid #2c5f7c;
  background: linear-gradient(135deg, #eef7fc 0%, #f7fbff 100%);
  box-shadow: 0 8rpx 18rpx rgba(44, 95, 124, 0.16);
}

.match-badge {
  position: absolute;
  top: -12rpx;
  left: 18rpx;
  background: linear-gradient(135deg, #ee6c4d, #c0392b);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 10rpx rgba(238, 108, 77, 0.35);
}

.hc-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
  margin-top: 10rpx;
}
.hc-name {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--accent-deep);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hc-rating {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}
.rating-star {
  color: #ffd76a;
  font-size: 22rpx;
}
.rating-num {
  font-size: 22rpx;
  color: var(--text-dark);
  font-weight: 700;
}

.hc-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}
.hc-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  font-weight: 600;
}
.tag-warn {
  background: rgba(238, 108, 77, 0.12);
  color: var(--accent-warn);
}
.tag-open {
  background: rgba(168, 230, 207, 0.3);
  color: #1d6d4a;
}
.tag-recommended {
  background: rgba(165, 215, 232, 0.26);
  color: #2c5f7c;
}
.hc-distance {
  font-size: 22rpx;
  color: var(--text-light);
  margin-left: auto;
}

.hc-address {
  font-size: 22rpx;
  color: var(--text-gray);
  display: block;
  margin-bottom: 10rpx;
}

.hc-spec {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 14rpx;
}
.hc-spec-tag {
  font-size: 20rpx;
  background: rgba(165, 215, 232, 0.22);
  color: var(--accent-mid);
  padding: 4rpx 12rpx;
  border-radius: 14rpx;
}

.hc-actions {
  display: flex;
  gap: 12rpx;
}
.hc-action-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.act-call {
  background: rgba(165, 215, 232, 0.22);
  color: var(--accent-mid);
}
.act-nav {
  background: linear-gradient(135deg, #4a90b8, #2c5f7c);
  color: #ffffff;
}
.act-call:active, .act-nav:active {
  transform: scale(0.97);
}

.report-action {
  margin-top: 12rpx;
}
.report-btn {
  width: 100%;
  height: 70rpx;
  border-radius: 14rpx;
  background: rgba(44, 95, 124, 0.08);
  color: var(--accent-deep);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.floating-send-wrap {
  position: fixed;
  right: 24rpx;
  bottom: calc(34rpx + env(safe-area-inset-bottom));
  z-index: 20;
}
.floating-send-btn {
  height: 84rpx;
  padding: 0 28rpx;
  border-radius: 42rpx;
  background: linear-gradient(135deg, #4a90b8, #2c5f7c);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 22rpx rgba(44, 95, 124, 0.28);
}
.floating-send-btn-disabled {
  opacity: 0.55;
}
