page {
  --accent-deep: #2c5f7c;
  --accent-mid: #4a90b8;
  --accent-soft: #a5d7e8;
  --accent-warn: #ee6c4d;
  --accent-mint: #a8e6cf;
  --text-dark: #1f2d3a;
  --text-gray: #6b7886;
  --text-light: #9aa6b2;
  background: linear-gradient(180deg, #d4ebf4 0%, #f4f7fa 28%, #f4f7fa 100%);
}

view, scroll-view, image, text, map {
  box-sizing: border-box;
}

.page {
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  padding: 16rpx 22rpx 0;
}

/* ===== Hero ===== */
.hero {
  position: relative;
  border-radius: 28rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 18rpx;
  background:
    radial-gradient(120% 120% at 100% 0%, rgba(168, 230, 207, 0.4) 0%, rgba(168, 230, 207, 0) 60%),
    linear-gradient(135deg, #4a90b8 0%, #2c5f7c 100%);
  color: #ffffff;
  overflow: hidden;
  box-shadow: 0 10rpx 28rpx rgba(44, 95, 124, 0.22);
}
.hero-decor {
  position: absolute;
  width: 220rpx;
  height: 220rpx;
  top: -80rpx;
  right: -60rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.32), rgba(255, 255, 255, 0) 70%);
}
.hero-eyebrow {
  position: relative;
  font-size: 22rpx;
  letter-spacing: 5rpx;
  opacity: 0.85;
  display: block;
  margin-bottom: 8rpx;
}
.hero-title {
  position: relative;
  font-size: 46rpx;
  font-weight: 800;
  display: block;
  margin-bottom: 18rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.18);
}
.recommend-banner {
  position: relative;
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.32);
  border-radius: 18rpx;
  padding: 14rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.rec-icon {
  font-size: 26rpx;
  flex-shrink: 0;
}
.rec-text {
  font-size: 24rpx;
  line-height: 1.4;
  color: #fff;
  flex: 1;
}
.rec-num {
  font-size: 28rpx;
  font-weight: 800;
  color: #ffe5a8;
  margin: 0 4rpx;
}

/* ===== Tab ===== */
.tab-bar {
  display: flex;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 6rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(74, 144, 184, 0.06);
  flex-shrink: 0;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: var(--text-gray);
  border-radius: 14rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}
.tab.active {
  background: linear-gradient(135deg, #4a90b8, #2c5f7c);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(44, 95, 124, 0.25);
}

/* ===== Map ===== */
.map-wrap {
  flex: 1;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 22rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 184, 0.08);
}
.map {
  width: 100%;
  height: 100%;
}

/* ===== List ===== */
.list-scroll {
  flex: 1;
  padding-bottom: 30rpx;
}

.hospital-card {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 184, 0.07);
}
.hospital-card:active {
  transform: scale(0.99);
}
.hospital-card.card-matched {
  border: 2rpx solid rgba(238, 108, 77, 0.5);
  background: linear-gradient(135deg, #fff8f3 0%, #ffffff 50%);
}

.match-badge {
  position: absolute;
  top: -12rpx;
  left: 18rpx;
  background: linear-gradient(135deg, #ee6c4d, #c0392b);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 10rpx rgba(238, 108, 77, 0.35);
}

.hc-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
  margin-top: 10rpx;
}
.hc-name {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--accent-deep);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hc-rating {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}
.rating-star {
  color: #ffd76a;
  font-size: 22rpx;
}
.rating-num {
  font-size: 22rpx;
  color: var(--text-dark);
  font-weight: 700;
}

.hc-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}
.hc-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  font-weight: 600;
}
.tag-warn {
  background: rgba(238, 108, 77, 0.12);
  color: var(--accent-warn);
}
.tag-recommended {
  background: rgba(168, 230, 207, 0.32);
  color: #1d6d4a;
}
.hc-distance {
  font-size: 22rpx;
  color: var(--text-light);
  margin-left: auto;
}

.hc-address {
  font-size: 22rpx;
  color: var(--text-gray);
  display: block;
  margin-bottom: 10rpx;
}

.hc-spec {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 14rpx;
}
.hc-spec-tag {
  font-size: 20rpx;
  background: rgba(165, 215, 232, 0.22);
  color: var(--accent-mid);
  padding: 4rpx 12rpx;
  border-radius: 14rpx;
}

.hc-actions {
  display: flex;
  gap: 12rpx;
}
.hc-action-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.act-call {
  background: rgba(165, 215, 232, 0.22);
  color: var(--accent-mid);
}
.act-nav {
  background: linear-gradient(135deg, #4a90b8, #2c5f7c);
  color: #ffffff;
}
.act-call:active, .act-nav:active {
  transform: scale(0.97);
}
