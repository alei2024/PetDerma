<navigation-bar title="附近宠物医院" back="{{true}}" color="white" background="#4a90b8"></navigation-bar>

<view class="page">
  <!-- 顶部 hero -->
  <view class="hero">
    <view class="hero-decor"></view>
    <text class="hero-eyebrow">VETERINARY NETWORK</text>
    <text class="hero-title">附近宠物医院</text>
    <view wx:if="{{diseaseHint}}" class="recommend-banner">
      <text class="rec-icon">🎯</text>
      <text class="rec-text">基于你的诊断「{{diseaseHint}}」,共找到 <text class="rec-num">{{matchedCount}}</text> 家擅长该病种的医院</text>
    </view>
    <view wx:else class="recommend-banner">
      <text class="rec-icon">📍</text>
      <text class="rec-text">已为你筛选距离最近的 {{list.length}} 家医院</text>
    </view>
  </view>

  <!-- list / map 切换 -->
  <view class="tab-bar">
    <view class="tab {{activeTab === 'list' ? 'active' : ''}}" bindtap="switchTab" data-tab="list">列表视图</view>
    <view class="tab {{activeTab === 'map' ? 'active' : ''}}" bindtap="switchTab" data-tab="map">地图视图</view>
  </view>

  <!-- 地图视图 -->
  <view wx:if="{{activeTab === 'map'}}" class="map-wrap">
    <map class="map" latitude="{{lat}}" longitude="{{lng}}" markers="{{markers}}" scale="13" show-location></map>
  </view>

  <!-- 列表视图 -->
  <scroll-view wx:else scroll-y class="list-scroll">
    <block wx:for="{{list}}" wx:key="_id">
      <view class="hospital-card {{item.matchScore > 0 ? 'card-matched' : ''}}" bindtap="onTapHospital" data-id="{{item._id}}">
        <view wx:if="{{item.matchScore > 0}}" class="match-badge">
          <text>✦ 推荐 · 擅长{{item.matchedSpecialty}}</text>
        </view>

        <view class="hc-header">
          <text class="hc-name">{{item.name}}</text>
          <view class="hc-rating">
            <text class="rating-star">★</text>
            <text class="rating-num">{{item.rating}}</text>
          </view>
        </view>

        <view class="hc-meta">
          <text wx:if="{{item.is24h}}" class="hc-tag tag-warn">24h 急诊</text>
          <view wx:if="{{item.isRecommended}}" class="hc-tag tag-recommended">本平台推荐</view>
          <text class="hc-distance">📍 {{item.distanceText}}</text>
        </view>

        <text class="hc-address">{{item.address}}</text>

        <view class="hc-spec">
          <block wx:for="{{item.specialties}}" wx:for-item="sp" wx:key="*this">
            <text class="hc-spec-tag">#{{sp}}</text>
          </block>
        </view>

        <view class="hc-actions">
          <view class="hc-action-btn act-call" catchtap="callPhone" data-phone="{{item.phone}}">
            <text>📞 拨打</text>
          </view>
          <view class="hc-action-btn act-nav" catchtap="navigateTo"
                data-lat="{{item.latitude}}" data-lng="{{item.longitude}}"
                data-name="{{item.name}}" data-address="{{item.address}}">
            <text>🧭 导航</text>
          </view>
        </view>
      </view>
    </block>
  </scroll-view>
</view>
