/* pages/knowledge/knowledge.wxss */
.container {
  padding: 30rpx;
  padding-bottom: 140rpx; /* 给底部圆形按钮预留空间 */
  box-sizing: border-box;
}

.search-area {
  width: 100%;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1 1 auto;
  min-width: 0;
  height: 80rpx;
  background-color: var(--bg-white);
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  border: 2rpx solid #e0e0e0;
  box-sizing: border-box;
}

.search-btn {
  height: 80rpx;
  background-color: var(--primary-blue);
  color: white;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: bold;
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 0 28rpx;
  min-width: 60rpx;
  max-width: 120rpx;
  width: auto;
  box-sizing: border-box;
}

.content-area {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.article-card {
  background-color: var(--bg-white);
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  margin: 0;
  width: 100%;
  transition: all 0.3s ease;
  cursor: pointer;
  box-sizing: border-box;
}

.article-card:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 5rpx rgba(0, 0, 0, 0.1);
}

.article-header {
  margin-bottom: 12rpx;
}

.article-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-dark);
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.article-meta {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.article-time {
  font-size: 24rpx;
  color: var(--text-light);
}

.article-summary {
  font-size: 26rpx;
  color: var(--text-gray);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.article-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.article-category {
  background-color: #E3F2FD;
  color: var(--primary-blue);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.article-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.read-count {
  font-size: 22rpx;
  color: var(--text-light);
}

.empty {
  text-align: center;
  color: var(--text-light);
  font-size: 26rpx;
  margin-top: 40rpx;
}

.bottom-buttons {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 60rpx;
  display: flex;
  justify-content: center;
  gap: 40rpx;
  padding: 0 30rpx;
  z-index: 100;
}

.circle-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: var(--primary-blue);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 20rpx rgba(165, 215, 232, 0.3);
  transition: all 0.3s ease;
}

.circle-btn.active {
  background-color: #8bc34a;
  box-shadow: 0 4rpx 20rpx rgba(139, 195, 74, 0.3);
  transform: scale(1.1);
}

.circle-btn:active {
  transform: scale(0.95);
}

/* 文章详情弹窗样式 */
.article-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

.article-modal {
  width: 90%;
  max-width: 700rpx;
  max-height: 85vh;
  min-height: 600rpx;
  background-color: white;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease;
  overflow: hidden;
  box-sizing: border-box;
  position: relative;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background-color: #fafafa;
}

.article-content {
  flex: 1;
  padding: 32rpx;
  box-sizing: border-box;
  width: 100%;
  min-height: 500rpx;
  max-height: 700rpx;
  position: relative;
}
.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-dark);
  flex: 1;
  margin-right: 20rpx;
  line-height: 1.3;
}

.modal-close {
  font-size: 48rpx;
  color: var(--text-light);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.3s ease;
}

.modal-close:active {
  background-color: #f0f0f0;
  transform: scale(0.9);
}

.article-info {
  padding: 24rpx 32rpx;
  background-color: #f8f9fa;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 26rpx;
  color: var(--text-gray);
  width: 140rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 26rpx;
  color: var(--text-dark);
  flex: 1;
}

.category-tag {
  background-color: var(--primary-blue);
  color: white;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  display: inline-block;
  width: auto;
  max-width: fit-content;
}


.article-content rich-text {
  line-height: 1.8;
  font-size: 28rpx;
  color: var(--text-dark);
  width: 100%;
  word-wrap: break-word;
  word-break: break-all;
  overflow-wrap: break-word;
  display: block;
  padding-bottom: 20rpx;
  min-height: 100rpx;
}

.modal-actions {
  display: flex;
  padding: 24rpx 32rpx;
  gap: 24rpx;
  border-top: 1rpx solid #f0f0f0;
  background-color: #fafafa;
  flex-shrink: 0;
  position: relative;
  z-index: 10;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background-color: white;
  border: 1rpx solid #e0e0e0;
  transition: all 0.3s ease;
}

.action-btn:active {
  background-color: #f0f0f0;
  transform: scale(0.98);
}

.action-icon {
  font-size: 32rpx;
  color: var(--primary-blue);
}

.action-text {
  font-size: 26rpx;
  color: var(--text-dark);
  font-weight: 500;
}

/* 动画效果 */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { 
    opacity: 0;
    transform: translateY(50rpx) scale(0.9);
  }
  to { 
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* 响应式适配 */
@media screen and (max-width: 375px) {
  .article-modal {
    width: 95%;
    max-height: 90vh;
    min-height: 500rpx;
  }
  
  .article-content {
    padding: 24rpx;
    min-height: 250rpx;
    max-height: 400rpx;
  }
  
  .modal-header {
    padding: 20rpx 24rpx;
  }
  
  .article-info {
    padding: 20rpx 24rpx;
  }
  
  .modal-actions {
    padding: 20rpx 24rpx;
  }
  
  .article-content rich-text {
    font-size: 26rpx;
  }
}

/* 确保按钮始终可见 */
.modal-actions {
  background-color: white;
  border-top: 2rpx solid #e0e0e0;
}

@media screen and (min-width: 414px) {
  .article-modal {
    max-height: 80vh;
    min-height: 650rpx;
  }
  
  .article-content {
    min-height: 350rpx;
    max-height: 600rpx;
  }
}
