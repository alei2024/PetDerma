/**message.wxss**/
.page-container {
  width: 100%;
  height: 100vh;
  background-color: #f5f5f5;
}

.content {
  padding: 20rpx;
  height: 100vh;
  margin-top: -20rpx;
  box-sizing: border-box;
}

/* 未读消息统计 */
.unread-summary {
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  margin-bottom: 10rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.2);
}

.unread-text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
}

.mark-all-read {
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.mark-all-read text {
  color: #ffffff;
  font-size: 24rpx;
}

/* 消息列表容器 */
.messages-container {
  padding-top: 10rpx;
  padding-bottom: 160rpx;
}

.message-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: flex-start;
  position: relative;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.message-item:active {
  transform: scale(0.98);
  background: #f8f9fa;
}

.message-item.unread {
  border-left: 6rpx solid #ff4757;
  background: #fff8f8;
}

.message-item.read {
  opacity: 0.8;
}

/* 消息图标 */
.message-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.icon-img {
  width: 48rpx;
  height: 48rpx;
}

/* 消息内容 */
.message-content {
  flex: 1;
  min-width: 0;
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.message-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  flex: 1;
  margin-right: 20rpx;
}

.message-time {
  font-size: 22rpx;
  color: #999999;
  flex-shrink: 0;
}

.message-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.5;
  display: block;
}

/* 未读标识 */
.unread-dot {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 16rpx;
  height: 16rpx;
  background: #ff4757;
  border-radius: 8rpx;
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  margin-top: 30rpx;
  text-align: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.5;
  margin-bottom: 40rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 20rpx;
}

/* 加载状态 */
.load-more {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}
