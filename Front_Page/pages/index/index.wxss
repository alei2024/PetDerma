/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #c5e4f1 0%, #f7f9fc 30%, #f5f5f5 100%);
  --accent-deep: #2c5f7c;
  --accent-mid: #4a90b8;
  --accent-soft: #a5d7e8;
  --accent-pink: #ffb3c1;
  --accent-mint: #a8e6cf;
  --accent-sun: #ffe5a8;
}

.scrollarea {
  flex: 1;
  overflow-y: auto;
  height: calc(100vh - 88rpx);
}

.container {
  width: 100%;
  padding: 16rpx 28rpx 60rpx;
  box-sizing: border-box;
  min-height: calc(100vh - 88rpx);
}

/* ===== 导航左侧消息按钮 ===== */
.nav-left-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  position: relative;
}
.nav-left-icon {
  width: 56rpx;
  height: 56rpx;
}
.message-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: #ff4757;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(255, 71, 87, 0.3);
}
.badge-text {
  color: #ffffff;
  font-size: 20rpx;
  font-weight: bold;
  line-height: 1;
  padding: 0 6rpx;
}

/* ===== Hero 区 ===== */
.hero {
  position: relative;
  width: 100%;
  border-radius: 32rpx;
  padding: 36rpx 32rpx 28rpx;
  margin-bottom: 32rpx;
  background:
    radial-gradient(120% 120% at 110% -20%, rgba(255, 179, 193, 0.55) 0%, rgba(255, 179, 193, 0) 50%),
    radial-gradient(140% 140% at -10% 110%, rgba(168, 230, 207, 0.45) 0%, rgba(168, 230, 207, 0) 55%),
    linear-gradient(135deg, #a5d7e8 0%, #6db8d8 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(74, 144, 184, 0.25);
  overflow: hidden;
  box-sizing: border-box;
}

.hero-blob {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(0.5rpx);
}
.hero-blob.blob-1 {
  width: 220rpx;
  height: 220rpx;
  top: -80rpx;
  right: -60rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 255, 0) 70%);
}
.hero-blob.blob-2 {
  width: 160rpx;
  height: 160rpx;
  bottom: -40rpx;
  left: 30%;
  background: radial-gradient(circle, rgba(255, 229, 168, 0.45) 0%, rgba(255, 229, 168, 0) 70%);
}

.hero-content {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 2;
}

.hero-text {
  display: flex;
  flex-direction: column;
  flex: 1;
}
.hero-greeting {
  font-size: 24rpx;
  letter-spacing: 2rpx;
  opacity: 0.85;
  margin-bottom: 8rpx;
}
.hero-title {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
  line-height: 1.1;
  text-shadow: 0 2rpx 8rpx rgba(44, 95, 124, 0.18);
}
.hero-subtitle {
  font-size: 26rpx;
  opacity: 0.92;
  line-height: 1.4;
}

.hero-image {
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  filter: drop-shadow(0 6rpx 12rpx rgba(0, 0, 0, 0.18));
}

/* Hero 内置统计条 */
.quick-stats {
  position: relative;
  z-index: 2;
  margin-top: 32rpx;
  padding: 20rpx 16rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
}
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
}
.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
  letter-spacing: 1rpx;
}
.stat-divider {
  width: 2rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.35);
}

/* ===== 通用 section header ===== */
.section-header {
  width: 100%;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--accent-deep);
  letter-spacing: 1rpx;
}
.section-action {
  font-size: 24rpx;
  color: var(--accent-mid);
  background: rgba(165, 215, 232, 0.25);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* ===== 我的宠物 横向卡片 ===== */
.pet-scroll {
  width: 100%;
  margin-bottom: 36rpx;
  white-space: nowrap;
}
.pet-list {
  display: flex;
  gap: 20rpx;
  padding: 4rpx 8rpx 16rpx;
}
.pet-card {
  flex-shrink: 0;
  width: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #ffffff;
  border-radius: 22rpx;
  padding: 20rpx 16rpx 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 184, 0.08);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.pet-card:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(74, 144, 184, 0.12);
}
.pet-avatar-wrap {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 12rpx;
}
.pet-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  object-fit: cover;
  border: 4rpx solid #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 184, 0.2);
}
.pet-status-dot {
  position: absolute;
  right: 0;
  bottom: 4rpx;
  width: 22rpx;
  height: 22rpx;
  background: #5dd39e;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(93, 211, 158, 0.5);
}
.pet-name {
  font-size: 26rpx;
  color: var(--accent-deep);
  font-weight: 600;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pet-add {
  background: rgba(165, 215, 232, 0.12);
  border: 3rpx dashed rgba(74, 144, 184, 0.45);
  box-shadow: none;
}
.pet-add-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  color: var(--accent-mid);
  font-size: 56rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  line-height: 1;
}

/* ===== 主功能网格 ===== */
.features-grid {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 36rpx;
  box-sizing: border-box;
}
.feature-card {
  position: relative;
  width: calc(50% - 10rpx);
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  box-shadow: 0 6rpx 20rpx rgba(74, 144, 184, 0.08);
  transition: transform 0.2s ease;
  overflow: hidden;
  box-sizing: border-box;
  min-height: 220rpx;
}
.feature-card:active {
  transform: scale(0.97);
}

.feature-shape {
  position: absolute;
  width: 180rpx;
  height: 180rpx;
  right: -60rpx;
  top: -60rpx;
  border-radius: 50%;
  opacity: 0.18;
  pointer-events: none;
}
.feat-diagnosis .feature-shape {
  background: linear-gradient(135deg, #a5d7e8, #4a90b8);
}
.feat-community .feature-shape {
  background: linear-gradient(135deg, #ffb3c1, #ff85a1);
}
.feat-knowledge .feature-shape {
  background: linear-gradient(135deg, #ffe5a8, #ffc870);
}
.feat-user .feature-shape {
  background: linear-gradient(135deg, #a8e6cf, #5dd39e);
}

.feature-icon-wrap {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
  position: relative;
  z-index: 2;
}
.feat-diagnosis .feature-icon-wrap {
  background: linear-gradient(135deg, rgba(165, 215, 232, 0.45), rgba(74, 144, 184, 0.25));
}
.feat-community .feature-icon-wrap {
  background: linear-gradient(135deg, rgba(255, 179, 193, 0.4), rgba(255, 133, 161, 0.2));
}
.feat-knowledge .feature-icon-wrap {
  background: linear-gradient(135deg, rgba(255, 229, 168, 0.5), rgba(255, 200, 112, 0.25));
}
.feat-user .feature-icon-wrap {
  background: linear-gradient(135deg, rgba(168, 230, 207, 0.45), rgba(93, 211, 158, 0.25));
}

.feature-icon {
  width: 52rpx;
  height: 52rpx;
}

.feature-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--accent-deep);
  margin-bottom: 6rpx;
  position: relative;
  z-index: 2;
}
.feature-desc {
  font-size: 22rpx;
  color: #7a8a96;
  line-height: 1.4;
  position: relative;
  z-index: 2;
}

.feature-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  z-index: 3;
  background: linear-gradient(135deg, #ff85a1, #ff5577);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  letter-spacing: 1rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 85, 119, 0.35);
}

/* ===== 每日科普 大卡 ===== */
.daily-card {
  position: relative;
  width: 100%;
  border-radius: 28rpx;
  padding: 32rpx 28rpx 28rpx;
  margin-bottom: 32rpx;
  background:
    radial-gradient(120% 100% at 100% 0%, rgba(255, 229, 168, 0.5) 0%, rgba(255, 229, 168, 0) 60%),
    linear-gradient(135deg, #6db8d8 0%, #2c5f7c 100%);
  color: #ffffff;
  box-shadow: 0 10rpx 32rpx rgba(44, 95, 124, 0.3);
  overflow: hidden;
  box-sizing: border-box;
}
.daily-card:active {
  transform: scale(0.99);
}

.daily-deco {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.daily-deco.deco-1 {
  width: 200rpx;
  height: 200rpx;
  top: -60rpx;
  right: -50rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0) 70%);
}
.daily-deco.deco-2 {
  width: 140rpx;
  height: 140rpx;
  bottom: -40rpx;
  left: 60%;
  background: radial-gradient(circle, rgba(168, 230, 207, 0.25) 0%, rgba(168, 230, 207, 0) 70%);
}

.daily-tag {
  display: inline-block;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  color: #ffffff;
  position: relative;
  z-index: 2;
}
.daily-topic {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
  margin-bottom: 14rpx;
  position: relative;
  z-index: 2;
}
.daily-summary {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  opacity: 0.92;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 2;
}
.daily-keywords {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 2;
}
.daily-kw {
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.18);
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  color: rgba(255, 255, 255, 0.92);
}
.daily-more {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
  position: relative;
  z-index: 2;
}
.daily-arrow {
  font-size: 30rpx;
  font-weight: 300;
}

/* ===== 健康提示 横条 ===== */
.tip-strip {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 184, 0.06);
  border-left: 8rpx solid var(--accent-soft);
  box-sizing: border-box;
}
.tip-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(255, 229, 168, 0.7), rgba(255, 200, 112, 0.4));
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.tip-icon-wrap image {
  width: 40rpx;
  height: 40rpx;
}
.tip-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.tip-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--accent-deep);
  margin-bottom: 4rpx;
}
.tip-text {
  font-size: 24rpx;
  color: #7a8a96;
  line-height: 1.5;
}

/* ===== 弹窗(保留兼容) ===== */
.popup-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 999;
}
.popup-panel {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-width: 620rpx;
  background: #fff;
  border-radius: 24rpx;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  max-height: 70vh;
  overflow: hidden;
  box-sizing: border-box;
}
.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 2rpx solid #eee;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--accent-deep);
}
.popup-close {
  font-size: 40rpx;
  color: #999;
}
.popup-body {
  padding: 5rpx 28rpx;
  height: 60vh;
  width: 100%;
  box-sizing: border-box;
}
.msg-item {
  padding: 20rpx 10rpx;
  border-bottom: 2rpx solid #f3f3f3;
}
.msg-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--accent-deep);
}
.msg-time {
  font-size: 22rpx;
  color: #999;
  margin: 6rpx 0 8rpx;
}
.msg-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* ===== 响应式 ===== */
@media screen and (max-width: 375px) {
  .container {
    padding: 12rpx 22rpx 50rpx;
  }
  .hero {
    padding: 28rpx 24rpx 22rpx;
  }
  .hero-title {
    font-size: 48rpx;
  }
  .hero-image {
    width: 120rpx;
    height: 120rpx;
  }
  .feature-card {
    width: calc(50% - 8rpx);
    padding: 24rpx 20rpx 20rpx;
    min-height: 200rpx;
  }
  .feature-title {
    font-size: 28rpx;
  }
}
@media screen and (min-width: 414px) {
  .feature-card {
    min-height: 240rpx;
    padding: 32rpx 28rpx 28rpx;
  }
  .hero-image {
    width: 160rpx;
    height: 160rpx;
  }
}

/* ============================================================
   机构端入口卡片（ToB）
   ============================================================ */
.institution-card {
  width: 100%;
  background: linear-gradient(135deg, #2c5f7c 0%, #4a8ba8 100%);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin: 0 0 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(44, 95, 124, 0.3);
  box-sizing: border-box;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.institution-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 50%;
}

.institution-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 15rpx rgba(44, 95, 124, 0.4);
}

.institution-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.institution-icon {
  width: 56rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.institution-icon image {
  width: 36rpx;
  height: 36rpx;
}

.institution-header-text {
  display: flex;
  flex-direction: column;
}

.institution-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #ffffff;
  line-height: 1.3;
}

.institution-subtitle {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.institution-desc {
  margin-bottom: 20rpx;
  padding: 14rpx 16rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
}

.institution-desc text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.5;
}

.institution-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 18rpx 0;
  gap: 8rpx;
}

.institution-btn:active {
  opacity: 0.9;
}

.institution-btn-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c5f7c;
}

.institution-arrow {
  font-size: 36rpx;
  color: #2c5f7c;
  font-weight: bold;
  line-height: 1;
}
