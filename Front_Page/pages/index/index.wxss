/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #A5D7E8 0%, #FFFFFF 40%);
}
.scrollarea {
  flex: 1;
  overflow-y: auto;
  height: calc(100vh - 88rpx); /* 减去导航栏高度 */
}

.container {
  width: 100%;
  padding: 20rpx 30rpx 40rpx;
  box-sizing: border-box;
  min-height: calc(100vh - 88rpx - 40rpx); /* 确保容器有足够高度 */
}

/* 导航左侧按钮 */
.nav-left-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  position: relative;
}
.nav-left-icon {
  width: 56rpx;
  height: 56rpx;
}

/* 消息红点 */
.message-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: #ff4757;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(255, 71, 87, 0.3);
}

.badge-text {
  color: #ffffff;
  font-size: 20rpx;
  font-weight: bold;
  line-height: 1;
  padding: 0 6rpx;
}

/* 欢迎区域样式 */
.welcome-section {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0 0 20rpx;
  padding: 24rpx;
  background-color: var(--primary-blue);
  border-radius: 20rpx;
  color: white;
  box-sizing: border-box;
}

.welcome-text {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.welcome-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.welcome-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

.welcome-image {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}

.welcome-image image {
  width: 100%;
  height: 100%;
}

/* 宠物头像列表 */
.pet-avatars {
  width: 100%;
  display: flex;
  gap: 20rpx;
  justify-content: center;
  flex-wrap: wrap;
  padding: 0;
  margin-bottom: 20rpx;
}

.pet-avatar {
  min-width: 120rpx;
  max-width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.avatar-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: var(--bg-white);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  /* 确保图片为标准圆形，防止压扁 */
  object-fit: cover;
  aspect-ratio: 1 / 1;
  display: block;
  /* 强制保持尺寸比例 */
  flex-shrink: 0;
}

.avatar-name {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--text-dark);
}

/* 功能区块样式 */
.features-grid {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin: 0 0 20rpx;
  box-sizing: border-box;
  gap: 20rpx;
}

.feature-item {
  width: calc(50% - 10rpx);
  background-color: white;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
  margin-bottom: 0;
  box-sizing: border-box;
  flex-shrink: 0;
  min-height: 180rpx;
}

.feature-item:active {
  transform: scale(0.98);
}

.feature-icon-container {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 16rpx;
  position: relative;
}

.primary {
  background-color: rgba(165, 215, 232, 0.2);
}
.secondary {
  background-color: rgba(255, 192, 203, 0.2);
}
.tertiary {
  background-color: rgba(255, 250, 205, 0.3);
}
.quaternary {
  background-color: rgba(189, 252, 201, 0.2);
}

.feature-icon {
  width: 48rpx;
  height: 48rpx;
}

.feature-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  color: var(--text-dark);
  text-align: center;
  word-wrap: break-word;
  line-height: 1.2;
}
.feature-desc {
  font-size: 24rpx;
  color: var(--text-light);
  text-align: center;
  word-wrap: break-word;
  line-height: 1.3;
}

/* 机构端入口 */
.institution-card {
  width: 100%;
  background: linear-gradient(135deg, #2c5f7c 0%, #4a8ba8 100%);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin: 0 0 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(44, 95, 124, 0.3);
  box-sizing: border-box;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.institution-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 50%;
}

.institution-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 15rpx rgba(44, 95, 124, 0.4);
}

.institution-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.institution-icon {
  width: 56rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.institution-icon image {
  width: 36rpx;
  height: 36rpx;
}

.institution-header-text {
  display: flex;
  flex-direction: column;
}

.institution-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #ffffff;
  line-height: 1.3;
}

.institution-subtitle {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.institution-desc {
  margin-bottom: 20rpx;
  padding: 14rpx 16rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
}

.institution-desc text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.5;
}

.institution-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 18rpx 0;
  gap: 8rpx;
}

.institution-btn:active {
  opacity: 0.9;
}

.institution-btn-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c5f7c;
}

.institution-arrow {
  font-size: 36rpx;
  color: #2c5f7c;
  font-weight: bold;
  line-height: 1;
}

/* 每日科普 */
.daily-knowledge {
  width: 100%;
  background: linear-gradient(135deg, #a5d7e8 0%, #e8f4fd 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  min-height: 180rpx;
  box-shadow: 0 4rpx 20rpx rgba(165, 215, 232, 0.3);
  margin: 0 0 20rpx;
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.daily-knowledge:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 15rpx rgba(165, 215, 232, 0.4);
}

.daily-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.daily-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c5f7c;
  margin: 0;
}

.daily-subtitle {
  font-size: 22rpx;
  color: #5a8ba8;
  background: rgba(255, 255, 255, 0.6);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.daily-content {
  margin-bottom: 20rpx;
}

.daily-topic {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #1a4a5c;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.daily-summary {
  display: block;
  font-size: 24rpx;
  color: #2c5f7c;
  line-height: 1.6;
  opacity: 0.9;
}

.daily-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.daily-more {
  font-size: 22rpx;
  color: #5a8ba8;
  background: rgba(255, 255, 255, 0.7);
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

/* 温馨提示样式 */
.tips-section {
  width: 100%;
  background-color: white;
  border-radius: 16rpx;
  padding: 20rpx;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  margin: 0 0 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.tips-icon {
  width: 60rpx;
  height: 60rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.tips-icon image {
  width: 100%;
  height: 100%;
}

.tips-content {
  flex: 1;
}

.tips-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.tips-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-dark);
  margin-right: 10rpx;
  margin-bottom: 0;
}
.tips-text {
  font-size: 24rpx;
  color: var(--text-gray);
  line-height: 1.5;
}

/* 弹窗样式 */
.popup-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 999;
}
.popup-panel {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-width: 620rpx;
  background: #fff;
  border-radius: 20rpx;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  max-height: 70vh;
  overflow: hidden;
  box-sizing: border-box;
}
.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 2rpx solid #eee;
}
.popup-close {
  font-size: 40rpx;
  color: var(--text-light);
}
.popup-body {
  padding: 5rpx 28rpx;
  height: 60vh;
  width: 105%;
  box-sizing: border-box;
}
.msg-item {
  padding: 20rpx 10rpx;
  border-bottom: 2rpx solid #f3f3f3;
}
.msg-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-dark);
  white-space: normal;
  word-break: break-all;
  width: 94%;
}
.msg-time {
  font-size: 22rpx;
  color: var(--text-light);
  margin: 6rpx 0 8rpx;
}
.msg-content {
  font-size: 26rpx;
  color: var(--text-gray);
  line-height: 1.6;
  white-space: normal;
  word-break: break-all;
  width: 95%;
}

/* 响应式适配 */
@media screen and (max-width: 375px) {
  .container {
    padding: 15rpx 20rpx 30rpx;
  }
  
  .welcome-section {
    padding: 20rpx;
  }
  
  .welcome-image {
    width: 100rpx;
    height: 100rpx;
  }
  
  .feature-item {
    width: calc(50% - 8rpx);
    padding: 20rpx;
    min-height: 160rpx;
  }

  .feature-title {
    font-size: 28rpx;
  }

  .feature-desc {
    font-size: 22rpx;
  }
  
  .tips-section {
    padding: 16rpx;
  }
  
  .daily-knowledge {
    padding: 20rpx;
    min-height: 160rpx;
  }

  .institution-card {
    padding: 22rpx 18rpx;
  }
  .institution-title {
    font-size: 30rpx;
  }
  .institution-desc text {
    font-size: 22rpx;
  }
  .institution-btn-text {
    font-size: 26rpx;
  }
}

@media screen and (min-width: 414px) {
  .feature-item {
    width: calc(50% - 12rpx);
    padding: 28rpx;
    min-height: 200rpx;
  }
  
  .welcome-section {
    padding: 28rpx;
  }
  
  .welcome-image {
    width: 140rpx;
    height: 140rpx;
  }
}
