<!--index.wxml-->
<navigation-bar title="PetDerma" back="{{false}}" color="white" background="#A5D7E8" titleStyle="font-size: 20px;">
	<view slot="left" class="nav-left-btn" bindtap="openMessages">
		<image class="nav-left-icon" src="/images/message_icon.svg" mode="aspectFit"></image>
		<view wx:if="{{unreadCount > 0}}" class="message-badge">
			<text class="badge-text">{{unreadCount > 99 ? '99+' : unreadCount}}</text>
		</view>
	</view>
</navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">
    <!-- 欢迎区域 -->
    <view class="welcome-section">
      <view class="welcome-text">
        <text class="welcome-title">欢迎来到PetDerma</text>
        <text class="welcome-subtitle">您的宠物皮肤健康助手</text>
      </view>
      <view class="welcome-image">
        <image src="/images/welcome.png" mode="aspectFit"></image>
      </view>
    </view>
    
		<!-- 宠物头像列表（从其他页面输入的数据，这里仅预留展示） -->
		<view class="pet-avatars">
			<block wx:for="{{petList}}" wx:key="id" wx:for-index="index" wx:for-item="item">
				<view class="pet-avatar" bindtap="onTapPet" data-id="{{item.id}}">
					<image class="avatar-img img-circle" src="{{item.avatar}}" mode="aspectFill"></image>
					<text class="avatar-name">{{item.name}}</text>
      </view>
			</block>
    </view>
    
    <!-- 功能区块 -->
    <view class="features-grid">
			<!-- 智能诊断入口（切换到底部导航页） -->
			<view class="feature-item" bindtap="navigateTo" data-url="/pages/diagnosis/diagnosis" data-tab="true">
        <view class="feature-icon-container primary">
          <image class="feature-icon" src="/images/diagnosis_icon.png" mode="aspectFit"></image>
        </view>
        <text class="feature-title">智能诊断</text>
        <text class="feature-desc">AI分析皮肤问题</text>
      </view>
      
			<!-- 社区交流入口（切换到底部导航页） -->
			<view class="feature-item" bindtap="navigateTo" data-url="/pages/community/community" data-tab="true">
        <view class="feature-icon-container secondary">
          <image class="feature-icon" src="/images/community_icon.png" mode="aspectFit"></image>
        </view>
        <text class="feature-title">社区交流</text>
        <text class="feature-desc">分享经验和案例</text>
      </view>
      
			<!-- 知识科普入口（普通页面） -->
			<view class="feature-item" bindtap="navigateTo" data-url="/pages/knowledge/knowledge" data-tab="false">
        <view class="feature-icon-container tertiary">
          <image class="feature-icon" src="/images/knowledge_icon.png" mode="aspectFit"></image>
        </view>
        <text class="feature-title">知识科普</text>
        <text class="feature-desc">学习防治知识</text>
      </view>
      
			<!-- 个人中心入口（切换到底部导航页） -->
			<view class="feature-item" bindtap="navigateTo" data-url="/pages/user/user" data-tab="true">
        <view class="feature-icon-container quaternary">
          <image class="feature-icon" src="/images/user_icon.png" mode="aspectFit"></image>
        </view>
        <text class="feature-title">个人中心</text>
        <text class="feature-desc">宠物健康管理</text>
      </view>
    </view>

    <!-- 机构端入口 -->
    <view class="institution-entry" bindtap="navigateToInstitution">
      <view class="institution-entry-header">
        <view class="institution-entry-icon">
          <image src="/images/doctor.png" mode="aspectFit"></image>
        </view>
        <view class="institution-entry-text">
          <text class="institution-entry-title">机构服务</text>
          <text class="institution-entry-desc">宠物医院 / 护理店入驻</text>
        </view>
      </view>
      <view class="institution-entry-features">
        <text class="institution-feature-text">AI预问诊管理 · 预约转化 · 复诊跟踪</text>
      </view>
      <view class="institution-entry-footer">
        <view class="institution-entry-btn">
          <text>机构工作台</text>
          <image class="arrow-icon" src="/images/arrow_right.png" mode="aspectFit"></image>
        </view>
      </view>
    </view>

    <!-- 温馨提示 -->
    <view class="tips-section">
      <view class="tips-icon">
        <image src="/images/tips_icon.png" mode="aspectFit"></image>
      </view>
      <view class="tips-content">
				<view class="tips-row">
        <text class="tips-title">健康提示</text>
        <text class="tips-text">{{healthTip}}</text>
				</view>
      </view>
    </view>

    <!-- 每日科普 -->
		<view class="daily-knowledge" bindtap="navigateToKnowledge">
			<view class="daily-header">
				<text class="daily-title">每日科普</text>
				<text class="daily-subtitle">根据本季易发疾病推荐</text>
			</view>
			<view class="daily-content">
				<text class="daily-topic">{{dailyKnowledge.title}}</text>
				<text class="daily-summary">{{dailyKnowledge.summary}}</text>
			</view>
			<view class="daily-footer">
				<text class="daily-more">点击查看详情 ></text>
			</view>
		</view>
  </view>
</scroll-view>

<!-- 消息弹窗 -->
<view wx:if="{{showMessagePopup}}" class="popup-mask" bindtap="closeMessages"></view>
<view wx:if="{{showMessagePopup}}" class="popup-panel">
	<view class="popup-header">
		<text>消息中心</text>
		<text class="popup-close" bindtap="closeMessages">×</text>
	</view>
	<scroll-view scroll-y class="popup-body">
		<block wx:for="{{messages}}" wx:key="id">
			<view class="msg-item">
				<view class="msg-title">{{item.title}}</view>
				<view class="msg-time">{{item.time}}</view>
				<view class="msg-content">{{item.content}}</view>
			</view>
		</block>
	</scroll-view>
</view>
