<!--index.wxml-->
<navigation-bar title="PetDerma" back="{{false}}" color="white" background="#a5d7e8" titleStyle="font-size: 20px; letter-spacing: 2px;">
  <view slot="left" class="nav-left-btn" bindtap="openMessages">
    <image class="nav-left-icon" src="/images/message_icon.svg" mode="aspectFit"></image>
    <view wx:if="{{unreadCount > 0}}" class="message-badge">
      <text class="badge-text">{{unreadCount > 99 ? '99+' : unreadCount}}</text>
    </view>
  </view>
</navigation-bar>

<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">

    <!-- ===== Hero ===== -->
    <view class="hero">
      <view class="hero-blob blob-1"></view>
      <view class="hero-blob blob-2"></view>

      <view class="hero-content">
        <view class="hero-text">
          <text class="hero-greeting">{{greeting}} · 让宠物皮肤更健康</text>
          <text class="hero-title">PetDerma</text>
          <text class="hero-subtitle">您的宠物皮肤健康助手</text>
        </view>
        <image class="hero-image" src="/images/welcome.png" mode="aspectFit"></image>
      </view>

      <view class="quick-stats">
        <view class="stat-item">
          <text class="stat-value">{{petList.length}}</text>
          <text class="stat-label">我的宠物</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{unreadCount}}</text>
          <text class="stat-label">未读消息</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{tipsList.length}}</text>
          <text class="stat-label">健康贴士</text>
        </view>
      </view>
    </view>

    <!-- ===== 我的宠物 ===== -->
    <view class="section-header">
      <text class="section-title">我的宠物</text>
      <text class="section-action" bindtap="navigateToPets">管理 ›</text>
    </view>
    <scroll-view scroll-x class="pet-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="pet-list">
        <block wx:for="{{petList}}" wx:key="id">
          <view class="pet-card" bindtap="onTapPet" data-id="{{item.id}}">
            <view class="pet-avatar-wrap">
              <image class="pet-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
              <view class="pet-status-dot"></view>
            </view>
            <text class="pet-name">{{item.name}}</text>
          </view>
        </block>
        <view class="pet-card pet-add" bindtap="navigateToAddPet">
          <view class="pet-add-icon">+</view>
          <text class="pet-name">添加宠物</text>
        </view>
      </view>
    </scroll-view>

    <!-- ===== 主功能 ===== -->
    <view class="features-grid">
      <view class="feature-card feat-diagnosis" bindtap="navigateTo" data-url="/pages/diagnosis/diagnosis" data-tab="true">
        <view class="feature-shape"></view>
        <view class="feature-icon-wrap">
          <image class="feature-icon" src="/images/diagnosis_icon.png" mode="aspectFit"></image>
        </view>
        <text class="feature-title">智能诊断</text>
        <text class="feature-desc">AI 分析宠物皮肤问题</text>
      </view>

      <view class="feature-card feat-community" bindtap="navigateTo" data-url="/pages/community/community" data-tab="true">
        <view class="feature-shape"></view>
        <view wx:if="{{hasNewPost}}" class="feature-badge">新动态</view>
        <view class="feature-icon-wrap">
          <image class="feature-icon" src="/images/community_icon.png" mode="aspectFit"></image>
        </view>
        <text class="feature-title">社区交流</text>
        <text class="feature-desc">分享治愈与护理经验</text>
      </view>

      <view class="feature-card feat-knowledge" bindtap="navigateTo" data-url="/pages/knowledge/knowledge" data-tab="false">
        <view class="feature-shape"></view>
        <view wx:if="{{hasNewArticle}}" class="feature-badge">每日更新</view>
        <view class="feature-icon-wrap">
          <image class="feature-icon" src="/images/knowledge_icon.png" mode="aspectFit"></image>
        </view>
        <text class="feature-title">知识科普</text>
        <text class="feature-desc">学习皮肤病防治</text>
      </view>

      <view class="feature-card feat-user" bindtap="navigateTo" data-url="/pages/user/user" data-tab="true">
        <view class="feature-shape"></view>
        <view class="feature-icon-wrap">
          <image class="feature-icon" src="/images/user_icon.png" mode="aspectFit"></image>
        </view>
        <text class="feature-title">个人中心</text>
        <text class="feature-desc">健康档案与历史记录</text>
      </view>
    </view>

    <!-- ===== 机构端入口（ToB） ===== -->
    <view class="institution-card" bindtap="navigateToInstitution">
      <view class="institution-header">
        <view class="institution-icon">
          <image src="/images/institution_icon.svg" mode="aspectFit"></image>
        </view>
        <view class="institution-header-text">
          <text class="institution-title">机构服务</text>
          <text class="institution-subtitle">宠物医院 / 护理店入驻</text>
        </view>
      </view>
      <view class="institution-desc">
        <text>AI预问诊管理 · 预约转化 · 复诊跟踪</text>
      </view>
      <view class="institution-btn">
        <text class="institution-btn-text">机构工作台</text>
        <text class="institution-arrow">›</text>
      </view>
    </view>

    <!-- ===== 每日科普 ===== -->
    <view class="daily-card" bindtap="navigateToKnowledge">
      <view class="daily-deco deco-1"></view>
      <view class="daily-deco deco-2"></view>

      <view class="daily-tag">每日科普 · 季节推荐</view>
      <text class="daily-topic">{{dailyKnowledge.title}}</text>
      <text class="daily-summary">{{dailyKnowledge.summary}}</text>

      <view wx:if="{{dailyKnowledge.keywords && dailyKnowledge.keywords.length > 0}}" class="daily-keywords">
        <block wx:for="{{dailyKnowledge.keywords}}" wx:key="*this">
          <text class="daily-kw">#{{item}}</text>
        </block>
      </view>

      <view class="daily-more">
        <text>查看完整内容</text>
        <text class="daily-arrow">›</text>
      </view>
    </view>

    <!-- ===== 健康贴士 ===== -->
    <view class="tip-strip">
      <view class="tip-icon-wrap">
        <image src="/images/tips_icon.png" mode="aspectFit"></image>
      </view>
      <view class="tip-body">
        <text class="tip-title">健康小贴士</text>
        <text class="tip-text">{{healthTip}}</text>
      </view>
    </view>

  </view>
</scroll-view>

<!-- 消息弹窗(保留兼容) -->
<view wx:if="{{showMessagePopup}}" class="popup-mask" bindtap="closeMessages"></view>
<view wx:if="{{showMessagePopup}}" class="popup-panel">
  <view class="popup-header">
    <text>消息中心</text>
    <text class="popup-close" bindtap="closeMessages">×</text>
  </view>
  <scroll-view scroll-y class="popup-body">
    <block wx:for="{{messages}}" wx:key="id">
      <view class="msg-item">
        <view class="msg-title">{{item.title}}</view>
        <view class="msg-time">{{item.time}}</view>
        <view class="msg-content">{{item.content}}</view>
      </view>
    </block>
  </scroll-view>
</view>
