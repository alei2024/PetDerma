page {
  --accent-deep: #2c5f7c;
  --accent-mid: #4a90b8;
  --accent-soft: #a5d7e8;
  --accent-pink: #ffb3c1;
  --accent-mint: #a8e6cf;
  --accent-warn: #ee6c4d;
  --bg-page: #f4f7fa;
  --text-dark: #1f2d3a;
  --text-gray: #6b7886;
  --text-light: #9aa6b2;
  background: linear-gradient(180deg, #d4ebf4 0%, #f4f7fa 28%, #f4f7fa 100%);
}

/* 项目 app.json 设了 defaultContentBox:true,统一改回 border-box */
view, scroll-view, image, text {
  box-sizing: border-box;
}

.page {
  height: 100vh;
  width: 100%;
  padding: 16rpx 28rpx 140rpx;
  box-sizing: border-box;
}

/* ===== Hero ===== */
.hero {
  position: relative;
  border-radius: 32rpx;
  padding: 36rpx 32rpx 28rpx;
  margin-bottom: 32rpx;
  background:
    radial-gradient(120% 120% at 110% -10%, rgba(168, 230, 207, 0.4) 0%, rgba(168, 230, 207, 0) 50%),
    linear-gradient(135deg, #4a90b8 0%, #2c5f7c 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(44, 95, 124, 0.25);
  overflow: hidden;
}
.hero-decor {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.hero-decor.d1 {
  width: 220rpx;
  height: 220rpx;
  top: -80rpx;
  right: -60rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0) 70%);
}
.hero-decor.d2 {
  width: 160rpx;
  height: 160rpx;
  bottom: -50rpx;
  left: 20%;
  background: radial-gradient(circle, rgba(168, 230, 207, 0.45) 0%, rgba(168, 230, 207, 0) 70%);
}
.hero-eyebrow {
  position: relative;
  display: block;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  opacity: 0.85;
  margin-bottom: 12rpx;
}
.hero-title {
  position: relative;
  display: block;
  font-size: 50rpx;
  font-weight: 800;
  line-height: 1.15;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}
.hero-subtitle {
  position: relative;
  display: block;
  font-size: 26rpx;
  opacity: 0.92;
  margin-bottom: 32rpx;
}
.hero-stats {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 18rpx 12rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.32);
  border-radius: 20rpx;
}
.hero-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.hs-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1;
}
.hs-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 1rpx;
}
.hero-stat-divider {
  width: 2rpx;
  height: 50rpx;
  background: rgba(255, 255, 255, 0.32);
}

/* ===== Section header ===== */
.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-bottom: 18rpx;
}
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--accent-deep);
  letter-spacing: 1rpx;
}
.section-action {
  font-size: 24rpx;
  color: var(--accent-mid);
  background: rgba(165, 215, 232, 0.25);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

/* ===== State ===== */
.state {
  width: 100%;
  border-radius: 24rpx;
  padding: 80rpx 30rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  color: var(--text-light);
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 184, 0.06);
}
.state-empty .empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.state-empty .empty-title {
  font-size: 30rpx;
  color: var(--accent-deep);
  font-weight: 700;
  margin-bottom: 6rpx;
}
.state-empty .empty-desc {
  font-size: 24rpx;
  color: var(--text-light);
  line-height: 1.5;
}

/* ===== Track card ===== */
.track-card {
  position: relative;
  display: flex;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 22rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 6rpx 22rpx rgba(74, 144, 184, 0.08);
  overflow: hidden;
  gap: 20rpx;
  transition: transform 0.2s ease;
}
.track-card:active {
  transform: scale(0.98);
}
.track-card-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
  border-radius: 28rpx;
}
.track-improving .track-card-bg {
  background: linear-gradient(135deg, rgba(168, 230, 207, 0.18), transparent 60%);
}
.track-stable .track-card-bg {
  background: linear-gradient(135deg, rgba(165, 215, 232, 0.18), transparent 60%);
}
.track-worsening .track-card-bg {
  background: linear-gradient(135deg, rgba(238, 108, 77, 0.16), transparent 60%);
}
.track-healed .track-card-bg {
  background: linear-gradient(135deg, rgba(168, 230, 207, 0.32), transparent 60%);
}

.track-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  background: #eef3f7;
  flex-shrink: 0;
  position: relative;
  z-index: 2;
}

.track-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  position: relative;
  z-index: 2;
  min-width: 0;
}

.track-row1 {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}
.track-name {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--accent-deep);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.track-trend-pill {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  white-space: nowrap;
}
.track-improving .track-trend-pill {
  background: rgba(168, 230, 207, 0.35);
  color: #1d6d4a;
}
.track-stable .track-trend-pill {
  background: rgba(165, 215, 232, 0.35);
  color: #1d6fa5;
}
.track-worsening .track-trend-pill {
  background: rgba(238, 108, 77, 0.2);
  color: #c0392b;
}
.track-healed .track-trend-pill {
  background: rgba(93, 211, 158, 0.32);
  color: #117a4a;
}

.track-meta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--text-gray);
  flex-wrap: wrap;
}
.meta-dot {
  color: var(--text-light);
}

.track-score-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 6rpx;
}
.score-block {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}
.score-num {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--accent-deep);
  line-height: 1;
  letter-spacing: -1rpx;
}
.score-unit {
  font-size: 22rpx;
  color: var(--text-light);
}
.score-bar {
  flex: 1;
  height: 12rpx;
  background: #eef3f7;
  border-radius: 8rpx;
  overflow: hidden;
}
.score-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, var(--accent-soft), var(--accent-mid));
  transition: width 0.6s ease;
}
.track-improving .score-bar-fill {
  background: linear-gradient(90deg, #a8e6cf, #5dd39e);
}
.track-worsening .score-bar-fill {
  background: linear-gradient(90deg, #ffd6cc, #ee6c4d);
}

.track-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}
.footer-predict {
  font-size: 22rpx;
  color: var(--accent-mid);
  font-weight: 700;
}

/* ===== FAB ===== */
.fab {
  position: fixed;
  right: 36rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4a90b8 0%, #2c5f7c 100%);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  font-weight: 200;
  z-index: 50;
  box-shadow: 0 12rpx 30rpx rgba(44, 95, 124, 0.45);
  line-height: 1;
}
.fab text {
  margin-top: -8rpx;
}
.fab:active {
  transform: scale(0.92);
}
