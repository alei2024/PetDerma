<navigation-bar title="风险评估" back="{{true}}" color="white" background="#4a90b8"></navigation-bar>

<scroll-view class="page" scroll-y enhanced="{{true}}">
  <view wx:if="{{loading}}" class="loading">分析中...</view>

  <block wx:elif="{{pet}}">
    <!-- Hero -->
    <view class="hero hero-{{overallLabel === '高风险' ? 'high' : overallLabel === '中等风险' ? 'mid' : 'low'}}">
      <view class="hero-decor"></view>
      <view class="pet-pill">
        <text>{{pet.name}} · {{pet.breed || '未知品种'}}</text>
      </view>
      <text class="risk-eyebrow">{{season}} · 综合风险评估</text>
      <view class="risk-score-row">
        <text class="risk-num">{{overall}}</text>
        <text class="risk-unit">/100</text>
      </view>
      <text class="risk-label">{{overallLabel}}</text>
      <view class="risk-meta">
        <text>📊 基于 {{historyCount}} 条历史诊断 · 品种 · 季节加权</text>
      </view>
    </view>

    <!-- 雷达图 -->
    <view class="card">
      <view class="card-header">
        <text class="card-title">五维风险雷达</text>
      </view>
      <image wx:if="{{radarSvg}}" class="radar" src="{{radarSvg}}" mode="widthFix" show-menu-by-longpress="{{false}}"></image>
    </view>

    <!-- 最高风险点 -->
    <view wx:if="{{topRisk}}" class="card top-risk-card">
      <view class="tr-row">
        <text class="tr-icon">🚨</text>
        <view class="tr-body">
          <text class="tr-label">最高风险维度</text>
          <text class="tr-name">{{topRisk.label}}</text>
        </view>
        <view class="tr-num-block">
          <text class="tr-num">{{topRisk.value}}</text>
          <text class="tr-unit">/100</text>
        </view>
      </view>
      <view class="tr-bar">
        <view class="tr-bar-fill" style="width: {{topRisk.value}}%;"></view>
      </view>
    </view>

    <!-- 预防建议 -->
    <view class="card">
      <view class="card-header">
        <text class="card-title">个性化预防建议</text>
      </view>
      <view class="advice-list">
        <block wx:for="{{advice}}" wx:key="*this">
          <view class="advice-item">
            <text class="advice-bullet">✓</text>
            <text class="advice-text">{{item}}</text>
          </view>
        </block>
      </view>
    </view>

    <view class="disclaimer">
      ⚠ 本评估为基于规则的简化模型,仅供参考。如出现持续异常请及时就医。
    </view>
  </block>
</scroll-view>
