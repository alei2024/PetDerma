page {
  --accent-deep: #2c5f7c;
  --accent-mid: #4a90b8;
  --accent-soft: #a5d7e8;
  --accent-warn: #ee6c4d;
  --text-dark: #1f2d3a;
  --text-gray: #6b7886;
  --text-light: #9aa6b2;
  background: linear-gradient(180deg, #d4ebf4 0%, #f4f7fa 28%, #f4f7fa 100%);
}

view, scroll-view, image, text {
  box-sizing: border-box;
}

.page {
  height: 100vh;
  width: 100%;
  padding: 16rpx 22rpx 60rpx;
}

.loading {
  text-align: center;
  padding: 200rpx 0;
  color: var(--text-light);
}

/* ===== Hero ===== */
.hero {
  position: relative;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
  color: #ffffff;
  overflow: hidden;
  box-shadow: 0 10rpx 28rpx rgba(44, 95, 124, 0.22);
}
.hero-low {
  background:
    radial-gradient(120% 100% at 100% 0%, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0) 60%),
    linear-gradient(135deg, #56ccaf 0%, #1d8a5b 100%);
}
.hero-mid {
  background:
    radial-gradient(120% 100% at 100% 0%, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0) 60%),
    linear-gradient(135deg, #f6a96b 0%, #ee6c4d 100%);
}
.hero-high {
  background:
    radial-gradient(120% 100% at 100% 0%, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0) 60%),
    linear-gradient(135deg, #ff7e7e 0%, #c0392b 100%);
}
.hero-decor {
  position: absolute;
  width: 220rpx;
  height: 220rpx;
  top: -80rpx;
  right: -60rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.32), rgba(255, 255, 255, 0) 70%);
}
.pet-pill {
  position: relative;
  display: inline-block;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
}
.risk-eyebrow {
  position: relative;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  opacity: 0.92;
  display: block;
  margin-bottom: 14rpx;
}
.risk-score-row {
  position: relative;
  display: flex;
  align-items: baseline;
  margin-bottom: 6rpx;
}
.risk-num {
  font-size: 110rpx;
  font-weight: 900;
  letter-spacing: -3rpx;
  line-height: 1;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.15);
}
.risk-unit {
  font-size: 30rpx;
  opacity: 0.85;
  margin-left: 4rpx;
}
.risk-label {
  position: relative;
  font-size: 30rpx;
  font-weight: 800;
  display: block;
  margin-bottom: 14rpx;
}
.risk-meta {
  position: relative;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.16);
  padding: 8rpx 14rpx;
  border-radius: 14rpx;
  display: inline-block;
}

/* ===== Card ===== */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 22rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 184, 0.06);
}
.card-header {
  margin-bottom: 14rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--accent-deep);
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.card-title::before {
  content: "";
  width: 8rpx;
  height: 26rpx;
  background: linear-gradient(180deg, var(--accent-soft), var(--accent-mid));
  border-radius: 4rpx;
}

.radar {
  width: 100%;
  display: block;
}

/* ===== Top risk ===== */
.top-risk-card {
  background: linear-gradient(135deg, rgba(238, 108, 77, 0.06), #ffffff 60%);
  border: 2rpx solid rgba(238, 108, 77, 0.25);
}
.tr-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 12rpx;
}
.tr-icon {
  font-size: 36rpx;
}
.tr-body {
  flex: 1;
}
.tr-label {
  font-size: 22rpx;
  color: var(--text-light);
  display: block;
}
.tr-name {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--accent-warn);
  display: block;
}
.tr-num-block {
  display: flex;
  align-items: baseline;
}
.tr-num {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--accent-warn);
  line-height: 1;
}
.tr-unit {
  font-size: 22rpx;
  color: var(--text-light);
  margin-left: 4rpx;
}
.tr-bar {
  width: 100%;
  height: 14rpx;
  background: rgba(238, 108, 77, 0.12);
  border-radius: 8rpx;
  overflow: hidden;
}
.tr-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #ffd76a, #ee6c4d);
  border-radius: 8rpx;
}

/* ===== Advice ===== */
.advice-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.advice-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 12rpx 14rpx;
  background: rgba(168, 230, 207, 0.18);
  border-radius: 14rpx;
  border-left: 6rpx solid #5dd39e;
}
.advice-bullet {
  color: #1d8a5b;
  font-weight: 800;
  font-size: 26rpx;
  flex-shrink: 0;
}
.advice-text {
  font-size: 26rpx;
  color: var(--text-dark);
  line-height: 1.55;
  flex: 1;
}

.disclaimer {
  font-size: 22rpx;
  color: var(--text-light);
  text-align: center;
  padding: 20rpx 12rpx;
  background: rgba(255, 229, 168, 0.32);
  border-radius: 16rpx;
  line-height: 1.6;
}
