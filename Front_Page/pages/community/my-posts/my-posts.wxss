.page-container {
  width: 100%;
  height: 100vh;
  background-color: #f5f5f5;
  position: relative;
}

.content {
  padding: 20rpx;
  padding-bottom: 120rpx; /* 为悬浮按钮留出空间 */
  height: 100vh;
  margin-top: -20rpx;
  box-sizing: border-box;
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  margin-top: 30rpx;
  text-align: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.5;
  margin-bottom: 40rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.empty-tip {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 60rpx;
}

.go-post-btn {
  background-color: #a5d7e8;
  color: white;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 28rpx;
}

/* 帖子列表样式 */
.posts-container {
  padding-top: 30rpx;
  padding-bottom: 40rpx;
}

.post-item {
  background-color: white;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 帖子头部 */
.post-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  object-fit: cover;
}

.user-details {
  display: flex;
  flex-direction: column;
}

.username {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-dark);
  margin-bottom: 5rpx;
}

.post-time {
  font-size: 24rpx;
  color: var(--text-gray);
  flex-shrink: 0;
}

/* 帖子内容 */
.post-content {
  margin-bottom: 20rpx;
}

.post-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-dark);
  display: block;
  margin-bottom: 20rpx;
  /* 限制显示最多6行文本 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 6;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-word;
}

/* 帖子标签 */
.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 0rpx;
}

.tag {
  background-color: var(--primary-blue);
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

/* 帖子统计 */
.post-statistics {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stat-text {
  font-size: 24rpx;
  color: #666;
}

/* 悬浮发布按钮 */
.floating-post-btn {
  position: fixed;
  bottom: 120rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  background-color: #a5d7e8;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(165, 215, 232, 0.4);
  z-index: 999;
}

.add-icon {
  width: 50rpx;
  height: 50rpx;
}

/* 加载状态 */
.loading,
.no-more {
  text-align: center;
  padding: 20rpx 40rpx 60rpx 40rpx;
  color: #999;
  font-size: 28rpx;
}
