.page-container {
  width: 100%;
  height: 100vh;
  background-color: #f5f5f5;
}

.content {
  padding: 20rpx;
  margin-top: 100rpx;
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.5;
  margin-bottom: 40rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.empty-tip {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 60rpx;
}

.go-community-btn {
  background-color: #a5d7e8;
  color: white;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 28rpx;
}

/* 评论列表样式 */
.comments-container {
  padding-bottom: 40rpx;
}

.comment-item {
  background-color: white;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 评论头部 */
.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.comment-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.user-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.comment-details {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.comment-time {
  font-size: 24rpx;
  color: #999;
}

.comment-type {
  background-color: #f0f8ff;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid #a5d7e8;
}

.type-label {
  font-size: 22rpx;
  color: #a5d7e8;
}

/* 我的评论内容 */
.my-comment-content {
  background-color: #f8f9fa;
  border-left: 4rpx solid #a5d7e8;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 0 12rpx 12rpx 0;
}

.comment-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

/* 原帖信息 */
.original-post {
  background-color: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 15rpx;
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.post-author-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 15rpx;
}

.post-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.post-author {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.post-preview {
  border-top: 1rpx solid #eee;
  padding-top: 15rpx;
}

.post-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

/* 查看详情提示 */
.view-detail {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 15rpx;
  background-color: #f0f8ff;
  border-radius: 8rpx;
  margin-top: 10rpx;
}

.detail-text {
  font-size: 24rpx;
  color: #a5d7e8;
  margin-right: 10rpx;
}

.arrow {
  font-size: 24rpx;
  color: #a5d7e8;
}

/* 加载状态 */
.loading,
.no-more {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}
