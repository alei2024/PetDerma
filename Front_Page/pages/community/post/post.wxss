/* pages/community/post/post.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

.container {
  flex: 1;
  background-color: #f5f5f5;
  padding: 0 30rpx;
  overflow-y: hidden;
  padding-bottom: 40rpx;
  overflow-y: scroll;
  -webkit-overflow-scrolling: touch;
  width: 104vw;
}

/* 内容输入区 */
.content-section {
  background-color: white;
  border-radius: 20rpx;
  margin: 20rpx 0;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  width: 84.5vw;
}

.content-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 15rpx;
}

/* 图片上传区 */
.image-section {
  background-color: white;
  border-radius: 20rpx;
  margin: 20rpx 0;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  width: 84.5vw;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  border-radius: 15rpx;
  object-fit: cover;
}

.delete-btn {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.7);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
}

.add-image-btn {
  width: 200rpx;
  height: 200rpx;
  border: 3rpx dashed #d0d0d0;
  border-radius: 15rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #fafafa;
}

.add-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.icon-camera {
  font-size: 50rpx;
  margin-bottom: 10rpx;
}

.add-text {
  font-size: 24rpx;
  color: #999;
}

.image-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 15rpx;
}

/* 标签选择区 */
.tags-section {
  background-color: white;
  border-radius: 20rpx;
  margin: 20rpx 0;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  width: 84.5vw;
}

.selected-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
  min-height: 50rpx;
}

.selected-tag {
  background-color: #a5d7e8;
  color: white;
  padding: 8rpx 15rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
}

.tag-categories {
  margin-bottom: 20rpx;
}

.tag-category {
  margin-bottom: 25rpx;
}

.category-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
  display: block;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag-item {
  background-color: #f8f8f8;
  color: #333;
  padding: 8rpx 15rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.tag-item.selected {
  background-color: #a5d7e8;
  color: white;
}

/* 自定义标签 */
.custom-tag-section {
  border-top: 2rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.custom-tag-input-wrapper {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.custom-tag-input {
  flex: 1;
  background-color: #f8f8f8;
  border-radius: 25rpx;
  padding: 15rpx 20rpx;
  font-size: 26rpx;
}

.add-custom-btn {
  background-color: #a5d7e8;
  color: white;
  padding: 15rpx 25rpx;
  border-radius: 25rpx;
  font-size: 26rpx;
}

/* 底部占位 */
.bottom-placeholder {
  height: 200rpx;
}

/* 左下角发布按钮 */
.bottom-publish-btn {
  position: fixed;
  bottom: 40rpx;
  left: 40rpx;
  width: 120rpx;
  height: 120rpx;
  background-color: rgba(165, 215, 232, 0.6);
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(165, 215, 232, 0.3);
  z-index: 1000;
  transition: all 0.3s ease;
}

.bottom-publish-btn.active {
  background-color: #a5d7e8;
  box-shadow: 0 8rpx 24rpx rgba(165, 215, 232, 0.6);
}

.publish-text {
  font-size: 28rpx;
  color: white;
  font-weight: bold;
}
