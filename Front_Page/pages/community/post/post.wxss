/* pages/community/post/post.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #F5F5F5;
}

.container {
  flex: 1;
  background-color: #F5F5F5;
  padding: 0 30rpx;
  overflow-y: hidden;
  padding-bottom: 40rpx;
  overflow-y: scroll;
  -webkit-overflow-scrolling: touch;
  width: 104vw;
}

/* 内容输入区 */
.content-section {
  background-color: white;
  border-radius: 20rpx;
  margin: 20rpx 0;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  width: 84.5vw;
}

.content-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 15rpx;
}

/* 图片上传区 */
.image-section {
  background-color: white;
  border-radius: 20rpx;
  margin: 20rpx 0;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  width: 84.5vw;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  border-radius: 15rpx;
  object-fit: cover;
}

.delete-btn {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.7);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
}

.add-image-btn {
  width: 200rpx;
  height: 200rpx;
  border: 3rpx dashed #D0D0D0;
  border-radius: 15rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #FAFAFA;
}

.add-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.icon-camera {
  font-size: 50rpx;
  margin-bottom: 10rpx;
}

.add-text {
  font-size: 24rpx;
  color: #999;
}

.image-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 15rpx;
}

/* 标签选择区 */
.tags-section {
  background-color: white;
  border-radius: 20rpx;
  margin: 20rpx 0;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  width: 84.5vw;
}

.selected-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
  min-height: 50rpx;
}

.selected-tag {
  background-color: #A5D7E8;
  color: white;
  padding: 8rpx 15rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
}

.tag-categories {
  margin-bottom: 20rpx;
}

.tag-category {
  margin-bottom: 25rpx;
}

.category-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
  display: block;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag-item {
  background-color: #F8F8F8;
  color: #333;
  padding: 8rpx 15rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.tag-item.selected {
  background-color: #A5D7E8;
  color: white;
}

/* 自定义标签 */
.custom-tag-section {
  border-top: 2rpx solid #F0F0F0;
  padding-top: 20rpx;
}

.custom-tag-input-wrapper {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.custom-tag-input {
  flex: 1;
  background-color: #F8F8F8;
  border-radius: 25rpx;
  padding: 15rpx 20rpx;
  font-size: 26rpx;
}

.add-custom-btn {
  background-color: #A5D7E8;
  color: white;
  padding: 15rpx 25rpx;
  border-radius: 25rpx;
  font-size: 26rpx;
}

/* 发布设置 */
.settings-section {
  background-color: white;
  border-radius: 20rpx;
  margin: 20rpx 0;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  width: 84.5vw;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F0F0F0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 28rpx;
  color: #333;
}

.setting-switch {
  transform: scale(0.8);
}

/* 底部占位 */
.bottom-placeholder {
  height: 200rpx;
}

/* 发布确认弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.publish-confirm-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background-color: white;
  border-radius: 20rpx;
  z-index: 1001;
  overflow: hidden;
}

.modal-header {
  padding: 40rpx 30rpx 20rpx;
  text-align: center;
  border-bottom: 2rpx solid #F0F0F0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-dark);
}

.modal-content {
  padding: 30rpx;
  text-align: center;
}

.confirm-text {
  font-size: 28rpx;
  color: var(--text-gray);
  line-height: 1.5;
}

.modal-actions {
  display: flex;
  border-top: 2rpx solid #F0F0F0;
}

.modal-btn {
  flex: 1;
  padding: 30rpx;
  text-align: center;
  font-size: 28rpx;
}

.cancel-btn {
  color: var(--text-gray);
  border-right: 2rpx solid #F0F0F0;
}

.confirm-btn {
  color: var(--primary-blue);
  font-weight: bold;
}

/* 加载弹窗 */
.loading-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-content {
  background-color: white;
  padding: 60rpx;
  border-radius: 20rpx;
  text-align: center;
}

.loading-icon {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #E0E0E0;
  border-top: 6rpx solid #A5D7E8;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #333;
}

/* 左下角发布按钮 */
.bottom-publish-btn {
  position: fixed;
  bottom: 40rpx;
  left: 40rpx;
  width: 120rpx;
  height: 120rpx;
  background-color: rgba(165, 215, 232, 0.6);
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(165, 215, 232, 0.3);
  z-index: 1000;
  transition: all 0.3s ease;
}

.bottom-publish-btn.active {
  background-color: #A5D7E8;
  box-shadow: 0 8rpx 24rpx rgba(165, 215, 232, 0.6);
}

.publish-text {
  font-size: 28rpx;
  color: white;
  font-weight: bold;
} 