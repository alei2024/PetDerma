/* pages/community/detail/detail.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #F5F5F5;
}

.page-container {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 20rpx;
  min-height: 100%;
}

/* 帖子详情 */
.post-detail {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.post-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
}

.user-details {
  display: flex;
  flex-direction: column;
}

.username {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.post-time {
  font-size: 24rpx;
  color: #999;
}

.follow-btn {
  padding: 12rpx 24rpx;
  border: 2rpx solid #A5D7E8;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #A5D7E8;
  background-color: transparent;
  transition: all 0.3s ease;
}

.follow-btn.followed {
  border-color: #999;
  color: #999;
}

/* 帖子内容 */
.post-content {
  margin-bottom: 30rpx;
}

.post-text {
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
  margin-bottom: 20rpx;
  word-wrap: break-word;
}

.post-images {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 20rpx;
}

.post-image {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
}

/* 单张图片时的样式 - 需要通过 JS 动态添加 class */
.post-images.single-image {
  grid-template-columns: 1fr;
}

.post-images.single-image .post-image {
  height: 400rpx;
  max-width: 500rpx;
  justify-self: start;
}

/* 标签 */
.post-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 30rpx;
}

.tag {
  padding: 8rpx 16rpx;
  background: rgba(165, 215, 232, 0.1);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #A5D7E8;
  border: 1rpx solid rgba(165, 215, 232, 0.3);
}

/* 互动数据 */
.post-stats {
  display: flex;
  gap: 30rpx;
  color: #999;
  font-size: 24rpx;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.stat-item {
  color: #666;
}

/* 互动按钮 */
.post-actions {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #666;
  transition: all 0.3s ease;
}

.action-item:active {
  transform: scale(0.95);
}

.action-icon {
  width: 44rpx;
  height: 44rpx;
}

.action-icon.liked,
.action-icon.collected {
  filter: hue-rotate(200deg) saturate(1.5);
}

.action-text.liked,
.action-text.collected {
  color: #A5D7E8;
}

/* 评论区 */
.comments-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.comments-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.comments-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.sort-options {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
}

.sort-option {
  color: #999;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.sort-option.active {
  color: #A5D7E8;
  background-color: rgba(165, 215, 232, 0.1);
  font-weight: bold;
}

/* 评论列表 */
.comments-list {
  min-height: 200rpx;
}

.comment-item {
  margin-bottom: 40rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f8f8f8;
}

.comment-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.comment-header {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.comment-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  flex-shrink: 0;
}

.comment-info {
  flex: 1;
  min-width: 0;
}

.comment-user {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.comment-username {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.comment-time {
  font-size: 22rpx;
  color: #999;
}

.comment-content {
  font-size: 28rpx;
  line-height: 1.5;
  color: #444;
  margin-bottom: 16rpx;
  word-wrap: break-word;
}

/* 评论图片 */
.comment-images {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.comment-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  background-color: #f0f0f0;
}

/* 评论操作 */
.comment-actions {
  display: flex;
  gap: 30rpx;
  margin-top: 16rpx;
}

.comment-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #999;
  transition: all 0.3s ease;
}

.comment-action:active {
  transform: scale(0.95);
}

.comment-action-icon {
  width: 32rpx;
  height: 32rpx;
}

.comment-action-icon.liked {
  filter: hue-rotate(200deg) saturate(1.5);
}

.comment-action-text.liked {
  color: #A5D7E8;
}

/* 回复列表 */
.replies-list {
  margin-top: 20rpx;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  border-left: 4rpx solid #A5D7E8;
}

.reply-item {
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 12rpx;
  word-wrap: break-word;
}

.reply-item:last-child {
  margin-bottom: 0;
}

.reply-username {
  color: #A5D7E8;
  font-weight: bold;
}

.reply-to {
  color: #999;
}

.reply-content {
  color: #444;
}

.reply-time {
  font-size: 20rpx;
  color: #999;
  margin-left: 12rpx;
}

.load-more-replies {
  color: #A5D7E8;
  font-size: 24rpx;
  margin-top: 16rpx;
  padding: 8rpx 0;
  text-align: center;
  border-top: 1rpx solid #e8f4f8;
}

/* 加载状态 */
.load-more-comments,
.no-more-comments,
.empty-comments {
  text-align: center;
  padding: 40rpx 20rpx;
  color: #999;
  font-size: 24rpx;
}

.empty-comments {
  color: #666;
  padding: 80rpx 20rpx;
}

/* 评论输入框 */
.comment-input-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 30rpx;
  padding-bottom: 60rpx; /* 增加底部安全区域 */
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 1000;
}

.comment-input-wrapper {
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
  background-color: white;
}

.comment-input {
  flex: 1;
  min-height: 80rpx;
  max-height: 200rpx;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.4;
  border: 1rpx solid #e8e8e8;
}

.comment-tools {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.tool-item {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  transition: all 0.3s ease;
}

.tool-item:active {
  transform: scale(0.9);
}

.tool-icon {
  width: 44rpx;
  height: 44rpx;
}

.comment-send-btn {
  padding: 12rpx 24rpx;
  background-color: #e8e8e8;
  color: #999;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 20rpx;
  transition: all 0.3s ease;
  min-width: 80rpx;
  text-align: center;
}

.comment-send-btn.active {
  background-color: #A5D7E8;
  color: white;
}

.comment-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 200rpx;
  background: rgba(0, 0, 0, 0.3);
  z-index: 999;
}

/* 评论图片预览 */
.comment-image-preview {
  position: fixed;
  bottom: 200rpx;
  left: 30rpx;
  right: 30rpx;
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 1001;
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.preview-image-item {
  position: relative;
  width: 120rpx;
  height: 120rpx;
}

.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background-color: #f0f0f0;
}

.delete-preview-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: #ff4757;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(255, 71, 87, 0.3);
}