/* pages/community/detail/detail.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

.page-container {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 20rpx;
  min-height: 100%;
}

/* 帖子详情 */
.post-detail {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  min-width: 90%;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.post-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
}

.user-details {
  display: flex;
  flex-direction: column;
}

.username {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.post-time {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.header-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.delete-btn {
  padding: 8rpx;
  border-radius: 50%;
  transition: background-color 0.2s;
}

.delete-btn:active {
  background-color: #f0f0f0;
}

.delete-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 帖子内容 */
.post-content {
  margin-bottom: 30rpx;
}

.post-text {
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
  margin-bottom: 20rpx;
  word-wrap: break-word;
}

/* 详情页面图片布局 - 统一为一行三张，多行显示所有图片 */
.post-images {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 20rpx;
  margin-bottom: 20rpx;
}

/* 1张图片 - 居中显示 */
.post-images[data-count="1"] {
  grid-template-columns: 1fr;
  max-width: 400rpx;
  margin: 20rpx auto;
}

.post-images[data-count="1"] .post-image {
  height: 400rpx;
  border-radius: 15rpx;
}

/* 2张图片及以上 - 统一样式 */
.post-images .post-image {
  height: 200rpx;
  border-radius: 12rpx;
}

/* 通用图片样式 */
.post-image {
  width: 100%;
  object-fit: cover;
  background-color: #f0f0f0;
  transition: transform 0.2s ease;
  cursor: pointer;
}

.post-image:active {
  transform: scale(0.95);
}

/* 标签 */
.post-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 30rpx;
}

.tag {
  padding: 8rpx 16rpx;
  background: rgba(165, 215, 232, 0.1);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #a5d7e8;
  border: 1rpx solid rgba(165, 215, 232, 0.3);
}

/* 互动数据 */
.post-stats {
  display: flex;
  gap: 30rpx;
  color: #999;
  font-size: 24rpx;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.stat-item {
  color: #666;
}

/* 互动按钮 */
.post-actions {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #666;
  transition: all 0.3s ease;
}

.action-item:active {
  transform: scale(0.95);
}

.action-icon {
  width: 44rpx;
  height: 44rpx;
}

/* 计数文字样式 - 统一样式，不再根据状态改变颜色 */
.action-count {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

/* 评论区 */
.comments-section {
  min-width: 90%;
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.comments-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.comments-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.sort-options {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
}

.sort-option {
  color: #999;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.sort-option.active {
  color: #a5d7e8;
  background-color: rgba(165, 215, 232, 0.1);
  font-weight: bold;
}

/* 评论列表 */
.comments-list {
  min-height: 200rpx;
}

.comment-item {
  margin-bottom: 40rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f8f8f8;
}

.comment-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.comment-header {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.comment-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  flex-shrink: 0;
}

.comment-info {
  flex: 1;
  min-width: 0;
}

.comment-user {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.comment-username {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.comment-time {
  font-size: 22rpx;
  color: #999;
}

.comment-content {
  font-size: 28rpx;
  line-height: 1.5;
  color: #444;
  margin-bottom: 16rpx;
  word-wrap: break-word;
}

/* 评论图片 */
.comment-images {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.comment-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  background-color: #f0f0f0;
}

/* 评论操作 */
.comment-actions {
  display: flex;
  gap: 30rpx;
  margin-top: 16rpx;
}

.comment-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #999;
  transition: all 0.3s ease;
}

.comment-action:active {
  transform: scale(0.95);
}

.comment-action-icon {
  width: 32rpx;
  height: 32rpx;
}

.comment-action-icon.liked {
  /* 移除filter效果，直接使用切换的图标文件 */
}

.comment-action-text {
  color: #333; /* 基础文字颜色为黑色 */
}

.comment-action-text.liked {
  color: #333; /* 点赞后也保持黑色，不变色 */
}

/* 回复列表 */
.replies-list {
  margin-top: 20rpx;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  border-left: 4rpx solid #a5d7e8;
}

.reply-item {
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 12rpx;
  word-wrap: break-word;
}

.reply-item:last-child {
  margin-bottom: 0;
}

.reply-username {
  color: #a5d7e8;
  font-weight: bold;
}

.reply-to {
  color: #999;
}

.reply-content {
  color: #444;
}

.reply-time {
  font-size: 20rpx;
  color: #999;
  margin-left: 12rpx;
}

.load-more-replies {
  color: #a5d7e8;
  font-size: 24rpx;
  margin-top: 16rpx;
  padding: 8rpx 0;
  text-align: center;
  border-top: 1rpx solid #e8f4f8;
}

/* 加载状态 */
.load-more-comments,
.no-more-comments,
.empty-comments {
  text-align: center;
  padding: 40rpx 20rpx;
  color: #999;
  font-size: 24rpx;
}

.empty-comments {
  color: #666;
  padding: 80rpx 20rpx;
}

/* 评论输入框 */
.comment-input-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 30rpx 40rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.15);
  z-index: 1001;
  border-top: 1rpx solid #e8e8e8;
}

.comment-input-wrapper {
  display: flex;
  align-items: flex-end;
  gap: 15rpx;
  background-color: white;
}

.comment-input {
  flex: 1;
  min-height: 100rpx;
  max-height: 200rpx;
  padding: 20rpx 25rpx;
  background: #f8f9fa;
  border-radius: 25rpx;
  font-size: 28rpx;
  line-height: 1.5;
  border: 1rpx solid #e0e0e0;
  box-sizing: border-box;
}

.comment-input:focus {
  border-color: #a5d7e8;
  background: #ffffff;
}

.comment-tools {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
}

/* 图片选择工具已移除 */

.comment-send-btn {
  padding: 15rpx 25rpx;
  background-color: #a5d7e8; /* 蓝色背景 */
  color: white; /* 白色文字 */
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 25rpx;
  transition: all 0.2s ease;
  min-width: 100rpx;
  text-align: center;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.comment-send-btn.active {
  background-color: #0056cc; /* 深蓝色背景（激活状态） */
  color: white;
  transform: scale(1.02);
}

.comment-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 999;
}

/* 评论图片预览 */
.comment-image-preview {
  position: fixed;
  bottom: 200rpx;
  left: 30rpx;
  right: 30rpx;
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 1001;
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.preview-image-item {
  position: relative;
  width: 120rpx;
  height: 120rpx;
}

.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background-color: #f0f0f0;
}

.delete-preview-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: #ff4757;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(255, 71, 87, 0.3);
}

/* 删除确认弹窗 */
.delete-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 2000;
}

.delete-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: white;
  border-radius: 20rpx;
  z-index: 2001;
  width: 600rpx;
  max-width: 90%;
}

.delete-modal-content {
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
}

.delete-modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.delete-modal-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 60rpx;
}

.delete-modal-actions {
  display: flex;
  gap: 20rpx;
}

.delete-cancel-btn,
.delete-confirm-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}

.delete-cancel-btn {
  background-color: #f5f5f5;
  color: #666;
}

.delete-confirm-btn {
  background-color: #ff4757;
  color: white;
}

.delete-cancel-btn:active {
  background-color: #e0e0e0;
}

.delete-confirm-btn:active {
  background-color: #ff3742;
}
