page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

.scrollarea {
  flex: 1;
  overflow-y: auto;
}

.container {
  padding: 0 30rpx 40rpx;
}

/* 医生信息 */
.doctor-header {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  background: white;
  border-radius: 20rpx;
  margin: 20rpx 0;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.doctor-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #f0f0f0;
  margin-right: 24rpx;
}

.doctor-info {
  flex: 1;
}

.doctor-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #2C5F7C;
  display: block;
}

.doctor-title {
  font-size: 24rpx;
  color: #5A8BA8;
  display: block;
  margin-top: 8rpx;
}

/* 数据概览 */
.stats-grid {
  display: flex;
  gap: 20rpx;
  margin: 20rpx 0;
}

.stat-card {
  flex: 1;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.stat-card:active {
  transform: scale(0.97);
}

.stat-number {
  font-size: 44rpx;
  font-weight: bold;
  color: #2C5F7C;
  display: block;
}

.stat-card.pending .stat-number {
  color: #FFB84D;
}

.stat-card.followup .stat-number {
  color: #FF6B6B;
}

.stat-label {
  font-size: 24rpx;
  color: #5A8BA8;
  display: block;
  margin-top: 8rpx;
}

/* 区域 */
.section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 20rpx 0;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2C5F7C;
  display: block;
  margin-bottom: 24rpx;
}

.section-header .section-title {
  margin-bottom: 0;
}

.section-more {
  font-size: 26rpx;
  color: #A5D7E8;
}

/* 快捷操作 */
.action-grid {
  display: flex;
  gap: 20rpx;
}

.action-item {
  flex: 1;
  background: #f8fbff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  border: 1rpx solid #e8f0fe;
}

.action-item:active {
  transform: scale(0.97);
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.action-icon.orange {
  color: #FF9800;
}

.action-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.action-desc {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 6rpx;
}

/* 病例卡片 */
.case-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.case-card {
  background: #f8faff;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #eef4ff;
}

.case-card:active {
  transform: scale(0.98);
}

.case-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.case-pet-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f0f0f0;
  margin-right: 16rpx;
}

.case-pet-info {
  flex: 1;
}

.case-pet-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.case-owner {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.case-severity {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #f0f0f0;
  color: #666;
}

.case-severity.light {
  background: #e8f5e9;
  color: #4caf50;
}

.case-severity.medium {
  background: #fff3e0;
  color: #ff9800;
}

.case-severity.heavy {
  background: #ffebee;
  color: #f44336;
}

.case-body {
  margin-bottom: 12rpx;
}

.case-disease {
  font-size: 26rpx;
  color: #555;
  display: block;
  margin-bottom: 4rpx;
}

.case-date {
  font-size: 22rpx;
  color: #bbb;
  display: block;
}

.case-footer {
  display: flex;
  gap: 12rpx;
}

.case-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  background: #e8f5e9;
  color: #4caf50;
}

.case-tag.followup {
  background: #ffebee;
  color: #f44336;
}

/* 空状态 */
.empty-state {
  padding: 60rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  display: block;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
  display: block;
}
