page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.scrollarea {
  flex: 1;
  overflow-y: auto;
}

.container {
  padding: 20rpx 30rpx 60rpx;
}

/* 卡片通用 */
.info-card,
.section-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2C5F7C;
  display: block;
  margin-bottom: 20rpx;
}

/* 信息头部 */
.info-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.info-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f0f0f0;
  margin-right: 20rpx;
}

.info-meta {
  flex: 1;
}

.info-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.info-breed {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.severity-badge {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
}

.severity-badge.light { background: #e8f5e9; color: #4caf50; }
.severity-badge.medium { background: #fff3e0; color: #ff9800; }
.severity-badge.heavy { background: #ffebee; color: #f44336; }

/* 信息行 */
.info-row {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #999;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

/* 诊断记录 */
.disease-item {
  background: #f8faff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #eef4ff;
}

.disease-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.disease-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.disease-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.disease-status.cured { background: #e8f5e9; color: #4caf50; }
.disease-status.uncured { background: #fff3e0; color: #ff9800; }

.disease-detail {
  display: flex;
  margin-bottom: 6rpx;
}

.detail-label {
  font-size: 24rpx;
  color: #999;
  width: 80rpx;
  flex-shrink: 0;
}

.detail-text {
  font-size: 24rpx;
  color: #555;
  flex: 1;
}

.disease-date {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
}

/* 图片 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.case-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

/* 摘要卡片 */
.summary-card {
  background: linear-gradient(135deg, #f0f9ff, #e8f4f8);
  border: 1rpx solid #d0ebf4;
}

.summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.summary-header .section-title {
  margin-bottom: 0;
}

.generate-btn {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  background: #A5D7E8;
  color: white;
  border-radius: 40rpx;
  border: none;
  line-height: 1.5;
  min-height: 56rpx;
  display: flex;
  align-items: center;
}

.generate-btn:active {
  background: #8bc7d8;
}

.summary-content {
  background: white;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.summary-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}

.trend-section {
  background: white;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.trend-label {
  font-size: 24rpx;
  color: #A5D7E8;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.trend-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 空占位 */
.empty-section {
  padding: 40rpx 0;
  text-align: center;
  color: #bbb;
  font-size: 26rpx;
}

/* 复诊管理 */
.followup-status {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.followup-info {
  flex: 1;
}

.followup-badge {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  display: inline-block;
}

.followup-badge.active { background: #ffebee; color: #f44336; }
.followup-badge.done { background: #e8f5e9; color: #4caf50; }
.followup-badge.none { background: #f0f0f0; color: #999; }

.followup-note {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-top: 8rpx;
}

.followup-edit {
  font-size: 26rpx;
  color: #A5D7E8;
  flex-shrink: 0;
}

.followup-form {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.form-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
}

.form-value {
  font-size: 26rpx;
  color: #333;
}

.form-input {
  flex: 1;
  height: 64rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
}

.form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  justify-content: flex-end;
}

.form-btn {
  font-size: 24rpx;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  border: none;
  line-height: 1.5;
  min-height: 56rpx;
  display: flex;
  align-items: center;
}

.form-btn.cancel {
  background: #f0f0f0;
  color: #666;
}

.form-btn.save {
  background: #A5D7E8;
  color: white;
}

.form-btn.remove {
  background: #ffebee;
  color: #f44336;
}

.complete-section {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.complete-btn {
  width: 100%;
  height: 72rpx;
  background: #4caf50;
  color: white;
  border-radius: 36rpx;
  font-size: 28rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.complete-btn:active {
  opacity: 0.8;
}
