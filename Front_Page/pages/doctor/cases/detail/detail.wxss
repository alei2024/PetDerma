page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}
.scrollarea {
  flex: 1;
  overflow-y: auto;
}
.container {
  padding: 20rpx 30rpx 60rpx;
}

/* 通用模块卡片 */
.module-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}
.module-header {
  margin-bottom: 20rpx;
}
.module-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2C5F7C;
}

/* 模块1：宠物信息 */
.pet-profile {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}
.pet-avatar-lg {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f0f0f0;
  flex-shrink: 0;
}
.pet-info-grid {
  flex: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
}
.pet-info-item {
  display: flex;
  flex-direction: column;
}
.pet-info-label {
  font-size: 20rpx;
  color: #999;
}
.pet-info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}
.pet-history {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 8rpx;
}
.history-title {
  font-size: 22rpx;
  color: #999;
}
.history-text {
  font-size: 24rpx;
  color: #555;
  margin-top: 4rpx;
  display: block;
}

/* 模块2：症状描述 */
.symptom-desc {
  background: #fff8e1;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.symptom-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.symptom-tag {
  background: #f0f7ff;
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
  display: flex;
  flex-direction: column;
  min-width: 100rpx;
  flex: 1;
}
.tag-label {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 4rpx;
}
.tag-val {
  font-size: 24rpx;
  color: #2C5F7C;
  font-weight: 500;
}

/* 模块3：图片 */
.image-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.image-tab {
  padding: 6rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  background: #f0f0f0;
  color: #666;
}
.image-tab.active {
  background: #A5D7E8;
  color: white;
}
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.case-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

/* 模块4：AI诊断 */
.diagnosis-card {
  background: linear-gradient(135deg, #f0f9ff, #e8f4f8);
  border: 1rpx solid #d0ebf4;
}
.diagnosis-list {
  margin-bottom: 16rpx;
}
.diagnosis-item {
  background: white;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 10rpx;
}
.diagnosis-rank {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 6rpx;
}
.diagnosis-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.diagnosis-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}
.diagnosis-prob {
  font-size: 28rpx;
  font-weight: bold;
}
.diagnosis-item.top1 .diagnosis-prob { color: #1565c0; }
.diagnosis-item.top2 .diagnosis-prob { color: #7b1fa2; }
.diagnosis-item.top3 .diagnosis-prob { color: #e65100; }
.diagnosis-bar {
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
}
.diagnosis-bar .bar-fill {
  height: 100%;
  border-radius: 4rpx;
  background: #A5D7E8;
}
.diagnosis-item.top1 .bar-fill { background: #1565c0; }
.diagnosis-item.top2 .bar-fill { background: #7b1fa2; }
.diagnosis-item.top3 .bar-fill { background: #e65100; }
.diagnosis-summary {
  background: white;
  border-radius: 12rpx;
  padding: 16rpx;
}
.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}
.summary-label {
  font-size: 24rpx;
  color: #999;
}
.summary-val {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}
.summary-val.reliability { color: #4caf50; }
.summary-val.suggest { color: #f44336; font-size: 24rpx; }

/* 模块5：严重程度 */
.severity-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
}
.severity-badge-lg {
  font-size: 32rpx;
  font-weight: bold;
  padding: 12rpx 32rpx;
  border-radius: 36rpx;
}
.severity-badge-lg.light { background: #e8f5e9; color: #4caf50; }
.severity-badge-lg.medium { background: #fff3e0; color: #ff9800; }
.severity-badge-lg.heavy { background: #ffebee; color: #f44336; }
.severity-score {
  text-align: center;
}
.score-num {
  font-size: 44rpx;
  font-weight: bold;
  color: #2C5F7C;
  display: block;
}
.score-label {
  font-size: 22rpx;
  color: #999;
}
.score-details {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.score-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.score-item-label {
  width: 140rpx;
  font-size: 22rpx;
  color: #666;
  flex-shrink: 0;
}
.score-bar {
  flex: 1;
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}
.score-bar .bar-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #4caf50, #ff9800);
}
.score-item-val {
  width: 60rpx;
  font-size: 22rpx;
  color: #999;
  text-align: right;
}

/* 模块6：机构处理建议 */
.action-grid-6 {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.action-item-6 {
  width: calc(33.33% - 11rpx);
  background: #f8faff;
  border: 1rpx solid #eef4ff;
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  text-align: center;
  box-sizing: border-box;
}
.action-item-6:active {
  transform: scale(0.95);
}
.action-icon-6 {
  font-size: 36rpx;
  display: block;
  margin-bottom: 8rpx;
}
.action-text-6 {
  font-size: 22rpx;
  color: #2C5F7C;
  font-weight: 500;
}
.internal-note {
  margin-top: 16rpx;
  background: #fff8e1;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
}
.note-label {
  font-size: 22rpx;
  color: #999;
}
.note-text {
  font-size: 24rpx;
  color: #555;
  display: block;
  margin-top: 6rpx;
  line-height: 1.5;
}
