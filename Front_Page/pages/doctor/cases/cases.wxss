page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}
.page {
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* 筛选标签 */
.filter-tabs {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 30rpx;
  background: white;
  overflow-x: auto;
  white-space: nowrap;
  flex-shrink: 0;
}
.filter-tab {
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  background: #f0f0f0;
  color: #666;
  font-size: 24rpx;
  flex-shrink: 0;
  transition: all 0.2s;
}
.filter-tab.active {
  background: #A5D7E8;
  color: white;
  font-weight: bold;
}
.list-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx 30rpx;
}

/* 病例卡片 */
.case-card {
  background: white;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}
.case-card:active { transform: scale(0.98); }

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.card-pet-info {
  display: flex;
  align-items: center;
  flex: 1;
}
.card-pet-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f0f0f0;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.card-pet-avatar image {
  width: 100%;
  height: 100%;
}
.card-pet-detail {
  flex: 1;
}
.card-pet-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
}
.card-pet-breed {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}
.card-severity {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  background: #f0f0f0;
  color: #666;
  flex-shrink: 0;
}
.card-severity.light { background: #e8f5e9; color: #4caf50; }
.card-severity.medium { background: #fff3e0; color: #ff9800; }
.card-severity.heavy { background: #ffebee; color: #f44336; }

/* 主诉 */
.card-symptom {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 14rpx;
}
.symptom-label {
  font-size: 22rpx;
  color: #999;
}
.symptom-text {
  font-size: 24rpx;
  color: #555;
  line-height: 1.5;
}

/* AI 结果标签 */
.card-ai-result {
  margin-bottom: 14rpx;
}
.ai-result-title {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}
.ai-result-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}
.ai-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  color: #666;
}
.ai-tag.top1 { background: #e3f2fd; color: #1565c0; }
.ai-tag.top2 { background: #f3e5f5; color: #7b1fa2; }
.ai-tag.top3 { background: #fff3e0; color: #e65100; }

/* 底部 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.card-meta {
  display: flex;
  gap: 20rpx;
}
.meta-item {
  font-size: 22rpx;
  color: #bbb;
}
.card-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}
.card-status.pending { background: #fff3e0; color: #ff9800; }
.card-status.done { background: #e8f5e9; color: #4caf50; }

/* 操作按钮 */
.card-actions {
  display: flex;
  gap: 12rpx;
}
.action-btn {
  flex: 1;
  height: 60rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
}
.action-btn.primary {
  background: #A5D7E8;
  color: white;
}
.action-btn.secondary {
  background: #f0f7ff;
  color: #2C5F7C;
}
.action-btn.outline {
  background: transparent;
  color: #A5D7E8;
  border: 2rpx solid #A5D7E8;
}
.action-btn.primary:active { background: #8bc7d8; }
.action-btn.secondary:active { background: #e0f0ff; }
.action-btn.outline:active { background: #f0faff; }

/* 空状态 */
.empty-state {
  padding: 100rpx 0;
  text-align: center;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}
.empty-hint {
  font-size: 22rpx;
  color: #ccc;
  display: block;
}
