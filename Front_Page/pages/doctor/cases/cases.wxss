page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 筛选标签 */
.filter-tabs {
  display: flex;
  padding: 20rpx 30rpx;
  gap: 16rpx;
  background: white;
}

.filter-tab {
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #f0f0f0;
}

.filter-tab.active {
  background: #A5D7E8;
  color: white;
  font-weight: bold;
}

.filter-tab:active {
  transform: scale(0.95);
}

/* 列表 */
.list-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 0 30rpx;
}

.case-list {
  padding: 20rpx 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.case-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.case-card:active {
  transform: scale(0.98);
}

.case-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.case-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f0f0f0;
  margin-right: 16rpx;
}

.case-meta {
  flex: 1;
}

.case-pet {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.case-owner {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.case-severity {
  font-size: 22rpx;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  background: #f0f0f0;
  color: #666;
}

.case-severity.light { background: #e8f5e9; color: #4caf50; }
.case-severity.medium { background: #fff3e0; color: #ff9800; }
.case-severity.heavy { background: #ffebee; color: #f44336; }

.case-info {
  margin-bottom: 12rpx;
}

.case-disease {
  font-size: 26rpx;
  color: #555;
  display: block;
  margin-bottom: 4rpx;
}

.case-date {
  font-size: 22rpx;
  color: #bbb;
  display: block;
}

.case-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.tag.summary-done { background: #e8f5e9; color: #4caf50; }
.tag.summary-pending { background: #fff8e1; color: #ff9800; }
.tag.need-followup { background: #ffebee; color: #f44336; }

/* 空状态 */
.empty-state {
  padding: 100rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  display: block;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
  display: block;
}
