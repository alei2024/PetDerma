page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}
.page {
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* 状态分栏 */
.status-tabs {
  display: flex;
  gap: 10rpx;
  padding: 20rpx 30rpx;
  background: white;
  overflow-x: auto;
  white-space: nowrap;
  flex-shrink: 0;
}
.status-tab {
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
  background: #f0f0f0;
  color: #666;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}
.status-tab.active {
  background: #A5D7E8;
  color: white;
  font-weight: bold;
}
.tab-count {
  font-size: 20rpx;
  background: rgba(255,255,255,0.3);
  color: white;
  min-width: 28rpx;
  height: 28rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
}
.status-tab:not(.active) .tab-count {
  background: #ff6b6b;
  color: white;
}
.tab-count.urgent {
  background: #ff6b6b !important;
  animation: pulse 1.5s infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

.list-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx 30rpx;
}

/* 预约卡片 */
.appt-card {
  background: white;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}
.appt-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.appt-pet-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
}
.appt-owner {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}
.appt-status-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.appt-status-badge.pending { background: #fff3e0; color: #ff9800; }
.appt-status-badge.confirmed { background: #e3f2fd; color: #1976d2; }
.appt-status-badge.today { background: #ffebee; color: #f44336; }
.appt-status-badge.completed { background: #e8f5e9; color: #4caf50; }
.appt-status-badge.cancelled { background: #f0f0f0; color: #999; }

/* 预约详情 */
.appt-details {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 16rpx;
}
.appt-detail-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
  gap: 8rpx;
}
.detail-icon {
  font-size: 22rpx;
  width: 36rpx;
  text-align: center;
}
.detail-text {
  font-size: 24rpx;
  color: #555;
}

/* 操作按钮 */
.appt-actions {
  display: flex;
  gap: 12rpx;
}
.appt-btn {
  flex: 1;
  height: 60rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
}
.appt-btn.primary {
  background: #A5D7E8;
  color: white;
}
.appt-btn.secondary {
  background: #f0f7ff;
  color: #2C5F7C;
}
.appt-btn.outline {
  background: transparent;
  color: #A5D7E8;
  border: 2rpx solid #A5D7E8;
}
.appt-btn.success {
  background: #4caf50;
  color: white;
}
.appt-btn.danger {
  background: #ffebee;
  color: #f44336;
}
.appt-btn:active { opacity: 0.8; }

/* 到店记录 */
.visit-notes {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  background: #f0f9ff;
  border-radius: 12rpx;
  border: 1rpx solid #d0ebf4;
}
.notes-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #2C5F7C;
  display: block;
  margin-bottom: 8rpx;
}
.notes-text {
  font-size: 22rpx;
  color: #555;
  display: block;
  margin-bottom: 4rpx;
  line-height: 1.5;
}

/* 空状态 */
.empty-state {
  padding: 100rpx 0;
  text-align: center;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}
.empty-hint {
  font-size: 22rpx;
  color: #ccc;
  display: block;
}
